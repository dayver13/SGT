@model SIRH.Web.ViewModels.PerfilFuncionarioVM

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Teletrabajo.cshtml";
}

<link rel="stylesheet" href="~/Content/sidebar.css">
<style>
    .aprobar {
        background-color: #4CAF50;
        color: white;
    }

    .rechazar {
        background-color: #f44336;
        color: white;
    }
    .corregir {
        background-color: #ff8000;
        color: white;
    }
</style>


<h2>Contratos Teletrabajo</h2>
<div class="jumbotron">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Numero de Solicitud</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                if (Model.solicitudes.Count > 0)
                {
                    for (var i = Model.solicitudes.Count; i > 0; i--)
                    {


                        <tr>
                            <td>i</td>
                            @if (!Model.solicitudes[i-1].AprobadoJefaturaInmediata && !Model.solicitudes[i-1].AprobadoJefaturaSuperior)
                            {
        
                                <td>Esperando aprobacion jefatura inmediata</td>
                            }
                            @if (Model.solicitudes[i-1].AprobadoJefaturaInmediata && !Model.solicitudes[i-1].AprobadoJefaturaSuperior)
                            {
                                <td>Esperando aprobacion jefatura superior</td>
                            }
                            @if (Model.solicitudes[i-1].AprobadoJefaturaInmediata && Model.solicitudes[i-1].AprobadoJefaturaSuperior)
                            {
                                <td>Aprobado</td>
                            }
                            <td>
                                @if(!Model.solicitudes[i-1].AprobadoJefaturaInmediata && !Model.solicitudes[i-1].AprobadoJefaturaSuperior) { 
                                    <button class="btn btn-success " id="btnEnviar" name="SubmitButton" type="submit" onclick="location.href='/GestionContrato'">
                                        Modificar Solicitud
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>

</div>
