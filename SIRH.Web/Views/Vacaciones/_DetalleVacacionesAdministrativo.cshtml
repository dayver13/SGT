@model SIRH.Web.ViewModels.FormularioRegistroVacacionesVM
@{
    if (Model != null)
    {
        <br />
        <div id="formulario">
            <div class="card">
                <div class="card-header">
                    <strong>Información del Funcionario</strong>
                </div>
                <div class="card-body">
                    <table class="table table-hover">
                        <tr>
                            <td>
                                <strong>@Html.LabelFor(model => model.Funcionario.Cedula): </strong>@Html.DisplayFor(model => model.Funcionario.Cedula)
                                @Html.HiddenFor(model => model.Funcionario.Cedula)
                            </td>
                            <td>
                                <strong>@Html.LabelFor(model => model.Funcionario.Nombre): </strong>@Model.Funcionario.Nombre @Model.Funcionario.PrimerApellido @Model.Funcionario.SegundoApellido
                                @Html.HiddenFor(model => model.Funcionario.Nombre)
                                @Html.HiddenFor(model => model.Funcionario.PrimerApellido)
                                @Html.HiddenFor(model => model.Funcionario.SegundoApellido)
                            </td>
                            <td>
                                <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion)
                                @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision)
                                @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision)
                            </td>
                            <td>
                                <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento)
                                @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento)
                            </td>
                            <td>
                                <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion)
                                @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>@Html.LabelFor(model => model.Funcionario.EstadoFuncionario): </strong>@Html.DisplayFor(model => model.Funcionario.EstadoFuncionario.DesEstadoFuncionario)
                                @Html.HiddenFor(model => model.Funcionario.EstadoFuncionario.IdEntidad)
                                @Html.HiddenFor(model => model.Funcionario.EstadoFuncionario.DesEstadoFuncionario)
                            </td>
                            <td>
                                @*<strong>@Html.Label("Jefatura Inmediata"): </strong>-*@
                                <strong>@Html.LabelFor(model => model.DetallePuesto.Clase): </strong>@Html.DisplayFor(model => model.DetallePuesto.Clase.IdEntidad) - @Html.DisplayFor(model => model.DetallePuesto.Clase.DesClase)
                                @Html.TextBoxFor(model => model.DetallePuesto.Clase.IdEntidad, new { @id = "CodClase", @class = "form-control col-2", @hidden = "hidden" })
                                @Html.HiddenFor(model => model.DetallePuesto.Clase.IdEntidad)
                                @Html.HiddenFor(model => model.DetallePuesto.Clase.DesClase)
                            </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>
                                <strong>@Html.LabelFor(model => model.Jefatura.JefeInmediato): </strong>@Html.DisplayFor(model => model.Jefatura.JefeInmediato.Mensaje)
                                @Html.HiddenFor(model => model.Jefatura.JefeInmediato.Cedula)
                                @Html.HiddenFor(model => model.Jefatura.JefeInmediato.Nombre)
                                @Html.HiddenFor(model => model.Jefatura.JefeInmediato.PrimerApellido)
                                @Html.HiddenFor(model => model.Jefatura.JefeInmediato.SegundoApellido)
                                @Html.HiddenFor(model => model.Jefatura.JefeInmediato.Mensaje)
                            </td>
                            <td>
                                <strong>@Html.LabelFor(model => model.Jefatura.JefeSuperior): </strong>@Html.DisplayFor(model => model.Jefatura.JefeSuperior.Mensaje)
                                @Html.HiddenFor(model => model.Jefatura.JefeSuperior.Cedula)
                                @Html.HiddenFor(model => model.Jefatura.JefeSuperior.Nombre)
                                @Html.HiddenFor(model => model.Jefatura.JefeSuperior.PrimerApellido)
                                @Html.HiddenFor(model => model.Jefatura.JefeSuperior.SegundoApellido)
                                @Html.HiddenFor(model => model.Jefatura.JefeSuperior.Mensaje)
                            </td>
                            <td>

                    </table>


                    @{
                        using (Ajax.BeginForm("RegistrarVacaciones", new AjaxOptions
                        {
                            UpdateTargetId = "Errores_Formulario",
                            HttpMethod = "POST",
                            OnSuccess = "SuccessCargarVacaciones",
                            OnComplete = "CompleteCargarVacaciones",
                            OnBegin = "BeginCargarVacaciones"
                        }))
                        {
                            @Html.HiddenFor(model => model.Funcionario.Cedula)
                            @Html.HiddenFor(model => model.PeriodoVacaciones.Periodo)
                            for (int i = 0; i < Model.PeriodosActivos.Count; i++)
                            {
                                @Html.HiddenFor(model => Model.PeriodosActivos[i].IdEntidad)
                                @Html.HiddenFor(model => Model.PeriodosActivos[i].Periodo)
                                @Html.HiddenFor(model => Model.PeriodosActivos[i].DiasDerecho)
                                @Html.HiddenFor(model => Model.PeriodosActivos[i].Saldo)
                            }
                            Html.ValidationSummary(true);


                            <div class="card">
                                <div class="card-header">
                                    <strong>Información de Vacaciones</strong>
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-3">
                                        @Html.Label(" Periodo(s):")
                                    </div>
                                    <div class="form-group  col-md-3">
                                        @Html.Label(" Saldos:")
                                    </div>

                                </div>
                                @if (Model.PeriodosActivos != null)
                                {
                                    @Html.TextBoxFor(model => model.PeriodosActivos.Count, new { @id = "cantidaPeriodos", @class = "form-control", @readonly = "True", @hidden = "True" })
                                    for (int i = 0; i < Model.PeriodosActivos.Count; i++)
                                    {
                                        <div class="form-row">
                                            <div class="col-md-3">
                                                @Html.TextBoxFor(model => model.PeriodosActivos[i].Periodo, new { @id = "periodo" + i, @class = "form-control", @readonly = "True" })
                                                @Html.ValidationMessageFor(model => model.PeriodosActivos[i].Periodo)
                                            </div>

                                            <div class="col-md-3">
                                                @Html.TextBoxFor(model => model.PeriodosActivos[i].Saldo, new { @id = "diaSolicitado" + i, @class = "form-control", @readonly = "True" })
                                                @Html.ValidationMessageFor(model => model.PeriodosActivos[i].Saldo)
                                            </div>
                                        </div>
                                    }
                                    <br />
                                                                <div class="form-row">
                                                                    <div class="col-md-3">
                                                                        <strong>Disponible: </strong>
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        @ViewBag.DiasTotales
                                                                        @Html.TextBox("saldoOriginal", (Double)ViewBag.DiasTotales, new { @id = "saldoOriginal", @class = "form-control", @readonly = "True", @hidden = "True" })
                                                                    </div>
                                                                </div>
                                }
                                else
                                {
                                    <div class="alert alert-info">
                                        No se encontraron periodos activos para el funcionario
                                    </div>
                                }

                            </div>

                        }
                        <div id="Errores_Formulario" style="margin-top:15px;"> </div>

                    }



                </div>
            </div>
        </div>

        <br />
                        }
}

<script src="~/Scripts/Pages/FormularioVacacionesPersonal.js" type="text/javascript"></script>

