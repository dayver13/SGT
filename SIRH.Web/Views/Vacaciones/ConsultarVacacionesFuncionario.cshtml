@model SIRH.Web.ViewModels.FormularioRegistroVacacionesVM
@{
    ViewBag.Title = "ConsultarVacacionesfuncionario";
    Layout = "~/Views/Shared/VacacionesGeneral.cshtml";
}
<link href="~/Content/datetimepicker.css" rel="stylesheet" />
<script src="~/Content/bootstrap-datepicker/js/jquery-3.4.1.slim.min.js"></script>
<!--link id="bs-css" href="https://netdna.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet"-->
<link id="bsdp-css" href="~/Content/bootstrap-datepicker/css/bootstrap-datepicker3.min.css" rel="stylesheet">

<h2>Detalle de vacaciones</h2>


@{
    Html.EnableClientValidation();
    using (Html.BeginForm(Ajax.BeginForm("ConsultarVacacionesFuncionario", "Vacaciones", new AjaxOptions
    {
        UpdateTargetId = "dvResultadoBusqueda",
        HttpMethod = "POST",
        OnSuccess = "SuccessCargarVacaciones",
        OnComplete = "CompleteCargarVacaciones",
        OnBegin = "BeginCargarVacaciones"
    })))
    {
        <div class="card">
            <h5 class="card-header"></h5>
            <div class="card-body">
                <center>
                    <div class="row">
                        <form class="form-inline">
                            @Html.HiddenFor(model => model.Jefatura.Funcionario.IdEntidad)
                            @Html.HiddenFor(model => model.Jefatura.Funcionario.Cedula)
                            @Html.HiddenFor(model => model.Jefatura.Funcionario.Nombre)
                            @Html.HiddenFor(model => model.Jefatura.Funcionario.PrimerApellido)
                            @Html.HiddenFor(model => model.Jefatura.Funcionario.SegundoApellido)
                            @Html.HiddenFor(model => model.Jefatura.Funcionario.Mensaje)
                            @Html.HiddenFor(model => model.Jefatura.JefeInmediato.IdEntidad)
                            @Html.HiddenFor(model => model.Jefatura.JefeInmediato.Cedula)
                            @Html.HiddenFor(model => model.Jefatura.JefeInmediato.Nombre)
                            @Html.HiddenFor(model => model.Jefatura.JefeInmediato.PrimerApellido)
                            @Html.HiddenFor(model => model.Jefatura.JefeInmediato.SegundoApellido)
                            @Html.HiddenFor(model => model.Jefatura.JefeInmediato.Mensaje)
                            @Html.HiddenFor(model => model.Jefatura.JefeSuperior.IdEntidad)
                            @Html.HiddenFor(model => model.Jefatura.JefeSuperior.Cedula)
                            @Html.HiddenFor(model => model.Jefatura.JefeSuperior.Nombre)
                            @Html.HiddenFor(model => model.Jefatura.JefeSuperior.PrimerApellido)
                            @Html.HiddenFor(model => model.Jefatura.JefeSuperior.SegundoApellido)
                            @Html.HiddenFor(model => model.Jefatura.JefeSuperior.Mensaje)

                            <div class="col-2">
                                <div class="form-group">
                                    @Html.Label("Funcionario")
                                </div>
                            </div>                           
                            <div class="col-4">
                                <div class="form-group">
                                    @Html.DropDownListFor(model => model.funcionarioSeleccionado, Model.FuncionariosAsociados, "Seleccione...",
                                    new
                                    {
                                        @class = "form-control",
                                        @readonly = "readonly",
                                        style = "width: 400px;"
                                    })
                                    @*Html.ValidationMessageFor(model => model.Funcionario.Cedula)*@
                                </div>
                            </div>
                            <div class="col-2">
                                <button class="btn btn-primary " id="btnBuscar" name="SubmitButton" type="submit" value="Buscar">
                                    <i class="fa fa-search"></i>
                                    Buscar
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="row">
                        <div class="col-10">
                            <center>
                                <div id="preloader" class="loader" hidden></div>
                            </center>
                        </div>
                    </div>
                </center>
            </div>
        </div>
    }
    <div id="dvResultadoBusqueda"></div>


}

<!--MODAL MENSAJE-->
<div class="modal fade" id="modal-mensaje" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header alert alert-danger" role="alert">
                <h5 class="modal-title" id="exampleModalCenterTitle">
                    <i class="fa fa-exclamation-circle d-inline" style="font-size:25px;">Mensaje</i>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <h9 id="mensaje"></h9>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")
<script src="~/Scripts/sidebar.js" type="text/javascript"></script>
<script src="~/scripts/jquery.unobtrusive-ajax.js" type="text/javascript"></script>
<script src="~/Scripts/Pages/FormularioVacaciones.js" type="text/javascript"></script>
@*<script src="~/Scripts/Pages/FormularioVacacionesPersonal.js" type="text/javascript"></script>*@
<script src="~/Scripts/datetimepicker.js" type="text/javascript"></script>
<script src="~/Scripts/datetimepicker-es.js" type="text/javascript"></script>
<script src="~/Content/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
<script src="~/Content/bootstrap-datepicker/locales/bootstrap-datepicker.es.min.js" charset="UTF-8"></script>