@model SIRH.Web.ViewModels.BusquedaVacacionesReportesVM
<link href="~/Content/datetimepicker.css" rel="stylesheet" />
@{
    if (Model != null)
    {
        if (Model.RegistroVacaciones == null && Model.ReintegrosVacaciones == null)
        {
            using (Ajax.BeginForm("ReportesHistoricos", "Vacaciones", new AjaxOptions
            {
                UpdateTargetId = "dvResultadoBusqueda",
                HttpMethod = "POST",
                OnComplete = "CompleteInfo",
                OnBegin = "BeginCargarInfo"

            }))
            {
                <div class="card">
                    <div class="card-header">
                        <strong> Filtros de busqueda</strong>
                    </div>
                    <div class="card-body">
                        <div class="form-group col-4" style="display:none;">
                            @Html.LabelFor(model => model.Funcionario.Cedula)
                            <span>
                                :
                            </span>
                            @Html.TextBoxFor(model => model.Funcionario.Cedula, new { @class = "form-control", @maxlength = "10" })
                            @Html.ValidationMessageFor(model => model.Funcionario.Cedula)
                        </div>
                        <div class="row" style="margin-bottom:5px;">


                            <div class="form-group col-3">
                                @Html.Label("Tipo de registro")
                                <span>:</span>
                                @Html.DropDownListFor(model => model.EstadoSeleccion, Model.Estados, "Tipo registro", new { @class = "form-control", @readonly = "readonly" })
                                @Html.ValidationMessageFor(model => Model.EstadoSeleccion)
                            </div>

                            <div class="form-group col-5">
                                @Html.LabelFor(model => model.SeleccionTipoVacaciones)
                                <span>:</span>
                                @Html.DropDownListFor(model => model.SeleccionTipoVacaciones, Model.tipoRegistroVacaciones, "Tipo de vacaciones", new { @class = "form-control", @readonly = "readonly" })
                                @Html.ValidationMessageFor(model => model.SeleccionTipoVacaciones)
                            </div>
                        </div>

                        <div class="row" style="margin-bottom:5px;">
                            <div class="form-group col-3">
                                @Html.Label("Periodos")
                                <span>:</span>
                                @Html.DropDownListFor(model => model.PeriodoSeleccion, Model.Periodos, "Periodo", new { @class = "form-control", @readonly = "readonly" })
                                @Html.ValidationMessageFor(model => Model.PeriodoSeleccion)
                                
                            </div>
                        </div>


                        <div class="row" style="margin-bottom:0px;">

                            <div class="form-group col-3">
                                @Html.Label("Fecha de inicio:")
                                <div class="start_date input-group mb-4">
                                    @Html.TextBoxFor(model => model.FechaInicioVacaciones, new { @id = "FechaInicioVacaciones", @class = "form-control start_date", @readonly = "readonly", @placeholder = "Fecha de Inicio" })
                                    @Html.ValidationMessageFor(model => model.FechaInicioVacaciones)
                                </div>
                            </div>

                            <div class="form-group col-4">
                                @Html.Label("Fecha final:")
                                <div class="end_date input-group mb-4">
                                    @Html.TextBoxFor(model => model.FechaFinalVacaciones, new { @id = "FechaFinalVacaciones", @class = "form-control start_date", @readonly = "readonly", @placeholder = "Fecha de Finalización" })
                                    @Html.ValidationMessageFor(model => model.FechaFinalVacaciones)
                                </div>
                            </div>
                        </div>


                        <div id="btnBuscar" class="form-group">

                            <button type="button" class="btn btn-primary " value="Limpiar" onclick="CleanSearch()">
                                <i class="fa fa-eraser"></i>
                                Limpiar
                            </button>

                            <button type="submit" class="btn btn-primary " value="Buscar" name="SubmitButton">
                                <i class="fa fa-search"></i>
                                Buscar
                            </button>
                        </div>

                        <div class="row">
                            <div class="col-5"></div>
                            <div id="preloader" class="loader" hidden></div>
                        </div>
                    </div>
                </div>

            }
            <div id="dvResultadoBusqueda"></div>
        }
        else if(Model.RegistroVacaciones != null || Model.ReintegrosVacaciones != null)
        {
            using (Html.BeginForm("ReporteDetalleHistorico", "Vacaciones", FormMethod.Post, new { @id = "thisForm" }))
            {
                if (Model.RegistroVacaciones != null)
                {
                    <br>
                    <div class="card">
                        @if (Model.RegistroRebajoColectivo)
                        {
                        <div class="card-header">
                            <center><h2>Registros de rebajo colectivo</h2></center>
                            <h2>
                                <button class="btn btn-danger " id="btnBuscar" name="SubmitButton" type="submit" value="PdfRegistros">
                                    <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                    Generar PDF
                                </button>
                                <button class="btn btn-success " id="btnBuscar" name="SubmitButton" type="submit" value="ExcelRegistros">
                                    <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                    Generar EXCEL
                                </button>
                            </h2>
                        </div>
                        }
                        else
                        {
                            <div class="card-header">
                                <center><h2>Registros de vacaciones</h2></center>
                                <h2>
                                    <button class="btn btn-danger " id="btnBuscar" name="SubmitButton" type="submit" value="PdfRegistros">
                                        <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                        Generar PDF
                                    </button>
                                    <button class="btn btn-success " id="btnBuscar" name="SubmitButton" type="submit" value="ExcelRegistros">
                                        <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                        Generar EXCEL
                                    </button>
                                </h2>
                            </div>
                        }
                        <div class="card">
                            <table class="table" style="margin-bottom:70px;">
                                <thead class="card-header">
                                    <tr>
                                        <th>Cedula</th>
                                        <th>Funcionario</th>
                                        <th>Periodo</th>
                                        <th>Fecha Inicio</th>
                                        <th>Fecha Fin</th>
                                        <th>Días</th>
                                        <th>N° documento</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.RegistroVacaciones.Count; i++)
                                    {
                                        if (Model.RegistroVacaciones[i].Estado == 1)
                                        {
                                            Model.estadoPeriodo = "Activo";
                                        }
                                        else
                                         if (Model.RegistroVacaciones[i].Estado == 2)
                                        {
                                            Model.estadoPeriodo = "Vencido";
                                        }
                                        else
                                        if (Model.RegistroVacaciones[i].Estado == 2)
                                        {
                                            Model.estadoPeriodo = "Anulado";
                                        }
                                        else
                                        {
                                            Model.estadoPeriodo = "Desconocido";
                                        }
                                        <tr></tr>
                                        <tr>
                                            <td>@Model.RegistroFuncionarios[i].Cedula</td>
                                            @Html.HiddenFor(model => Model.RegistroFuncionarios[i].Cedula)

                                            <td>@Model.RegistroFuncionarios[i].Nombre @Model.RegistroFuncionarios[i].PrimerApellido</td>
                                            @Html.HiddenFor(model => Model.RegistroFuncionarios[i].PrimerApellido)
                                            @Html.HiddenFor(model => Model.RegistroFuncionarios[i].Nombre)

                                            <td>@Model.PeriodosVacaciones[i].Periodo</td>
                                            @Html.HiddenFor(model => Model.PeriodosVacaciones[i].Periodo)

                                            <td>@Model.RegistroVacaciones[i].FechaRige.ToShortDateString()</td>
                                            @Html.HiddenFor(model => Model.RegistroVacaciones[i].FechaRige)

                                            <td>@Model.RegistroVacaciones[i].FechaVence.ToShortDateString()</td>
                                            @Html.HiddenFor(model => Model.RegistroVacaciones[i].FechaVence)

                                            <td>@Model.RegistroVacaciones[i].Dias</td>
                                            @Html.HiddenFor(model => Model.RegistroVacaciones[i].Dias)

                                            <td>@Model.RegistroVacaciones[i].NumeroTransaccion</td>
                                            @Html.HiddenFor(model => Model.RegistroVacaciones[i].NumeroTransaccion)

                                            <td>@Model.estadoPeriodo</td>
                                            @Html.HiddenFor(model => Model.RegistroVacaciones[i].Estado)
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <br>

                }
                if (Model.ReintegrosVacaciones != null)
                {
                    <br>
                    <div class="card">
                        <div class="card-header">
                            <center><h2>Reintegros de vacaciones</h2></center>
                            <h2>
                                <button class="btn btn-danger " id="btnBuscar" name="SubmitButton" type="submit" value="PdfReintegros">
                                    <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                    Generar PDF
                                </button>                    
                                <button class="btn btn-success " id="btnBuscar" name="SubmitButton" type="submit" value="ExcelReintegros">
                                    <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                    Generar EXCEL
                                </button>                    
                            </h2>
                        </div>
                        <div class="card">
                            <table class="table" style="margin-bottom:70px;">
                                <thead class="card-header">
                                    <tr>
                                        <th>Cedula</th>
                                        <th>Funcionario</th>
                                        <th>Periodo</th>
                                        <th>Fecha rige</th>
                                        <th>Observaciones</th>
                                        <th>N° solicitud</th>
                                        <th>Cantidad de dias</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.ReintegrosVacaciones.Count; i++)
                                    {
                                        <tr></tr>
                                        <tr>
                                            <td>@Model.RegistroFuncionarios[i].Cedula</td>
                                            @Html.HiddenFor(model => Model.RegistroFuncionarios[i].Cedula)

                                            <td>@Model.RegistroFuncionarios[i].Nombre @Model.RegistroFuncionarios[i].PrimerApellido</td>
                                            @Html.HiddenFor(model => Model.RegistroFuncionarios[i].PrimerApellido)
                                            @Html.HiddenFor(model => Model.RegistroFuncionarios[i].Nombre)

                                            <td>@Model.PeriodosVacaciones[i].Periodo</td>
                                            @Html.HiddenFor(model => Model.PeriodosVacaciones[i].Periodo)

                                            <td>@Model.ReintegrosVacaciones[i].FechaRige</td>
                                            @Html.HiddenFor(model => Model.ReintegrosVacaciones[i].FechaRige)

                                            <td>@Model.ReintegrosVacaciones[i].Observaciones</td>
                                            @Html.HiddenFor(model => Model.ReintegrosVacaciones[i].Observaciones)
                                            <td>@Model.ReintegrosVacaciones[i].SolReintegro</td>
                                            @Html.HiddenFor(model => Model.ReintegrosVacaciones[i].SolReintegro)
                                            <td>@Model.ReintegrosVacaciones[i].CantidadDias</td>
                                            @Html.HiddenFor(model => Model.ReintegrosVacaciones[i].CantidadDias)
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <br>

                }
            }
        }

    }
}

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")


<script src="~/scripts/jquery.unobtrusive-ajax.js" type="text/javascript"></script>
<script src="~/Scripts/Pages/ReportesVacaciones.js" type="text/javascript"></script>
<script src="~/Scripts/datetimepicker.js" type="text/javascript"></script>
<script src="~/Scripts/datetimepicker-es.js" type="text/javascript"></script>

