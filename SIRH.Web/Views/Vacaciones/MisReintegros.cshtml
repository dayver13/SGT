@model SIRH.Web.ViewModels.FormularioRegistroVacacionesVM
@{
    ViewBag.Title = "MisReintegros";
    Layout = "~/Views/Shared/VacacionesGeneral.cshtml";
}

<h2>Mis Reintegros</h2>
@if (Session["ReintegroActivo"] != null)
{
    <div class="alert alert-success">Reintegro procesado con éxito!</div>
}
<br />
<div id="formulario">
    <div class="card">
        <div class="card-header">
            <strong>Información del Funcionario</strong>
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <tr>
                    <td>
                        <strong>@Html.LabelFor(model => model.Funcionario.Cedula): </strong>@Html.DisplayFor(model => model.Funcionario.Cedula)
                        @Html.HiddenFor(model => model.Funcionario.Cedula)
                    </td>
                    <td>
                        <strong>@Html.LabelFor(model => model.Funcionario.Nombre): </strong>@Model.Funcionario.Nombre @Model.Funcionario.PrimerApellido @Model.Funcionario.SegundoApellido
                        @Html.HiddenFor(model => model.Funcionario.Nombre)
                        @Html.HiddenFor(model => model.Funcionario.PrimerApellido)
                        @Html.HiddenFor(model => model.Funcionario.SegundoApellido)
                    </td>
                    <td>
                        <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion)
                        @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion)
                    </td>
                </tr>
                <tr>
                    <td>
                        <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision)
                        @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision)
                    </td>
                    <td>
                        <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento)
                        @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento)
                    </td>
                    <td>
                        <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion)
                        @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion)
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td>
                        @*<strong>@Html.Label("Jefatura Inmediata"): </strong>-*@
                        <strong>@Html.LabelFor(model => model.Jefatura.JefeInmediato): </strong>@Html.DisplayFor(model => model.Jefatura.JefeInmediato.Mensaje)
                        @Html.HiddenFor(model => model.Jefatura.JefeInmediato.Cedula)
                        @Html.HiddenFor(model => model.Jefatura.JefeInmediato.Nombre)
                        @Html.HiddenFor(model => model.Jefatura.JefeInmediato.PrimerApellido)
                        @Html.HiddenFor(model => model.Jefatura.JefeInmediato.SegundoApellido)
                        @Html.HiddenFor(model => model.Jefatura.JefeInmediato.Mensaje)
                    </td>
                    <td>
                        @*<strong>@Html.Label("Jefatura Superior"): </strong>-*@
                        <strong>@Html.LabelFor(model => model.Jefatura.JefeSuperior): </strong>@Html.DisplayFor(model => model.Jefatura.JefeSuperior.Mensaje)
                        @Html.HiddenFor(model => model.Jefatura.JefeSuperior.Cedula)
                        @Html.HiddenFor(model => model.Jefatura.JefeSuperior.Nombre)
                        @Html.HiddenFor(model => model.Jefatura.JefeSuperior.PrimerApellido)
                        @Html.HiddenFor(model => model.Jefatura.JefeSuperior.SegundoApellido)
                        @Html.HiddenFor(model => model.Jefatura.JefeSuperior.Mensaje)
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
<br />
<br />
@if (@Model != null)
{
    <div id="tabs">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item">
                <a id="tab1" class="nav-link @(Session["ReintegroActivo"] != null ? "" : "active")" href="#tabs-1" data-toggle="tab" role="tab" aria-controls="tabs-1" aria-selected="true"> Aprobadas</a>
            </li>
            <li class="nav-item">
                <a id="tab2" class="nav-link @(Session["ReintegroActivo"] == null ? "" : "active")" href="#tabs-2" data-toggle="tab" role="tab" aria-controls="tabs-2" aria-selected="false"> Pendientes</a>
            </li>
            <li class="nav-item">
                <a id="tab3" class="nav-link" href="#tabs-3" data-toggle="tab" role="tab" aria-controls="tabs-3" aria-selected="false">Rechazadas</a>
            </li>
            <li class="nav-item">
                <a id="tab3" class="nav-link" href="#tabs-4" data-toggle="tab" role="tab" aria-controls="tabs-4" aria-selected="false">Anuladas</a>
            </li>
        </ul>
        <div class="tab-content" id="myTabContent">
            <div id="tabs-1" class="tab-pane fade  @(Session["ReintegroActivo"] != null ? "" : "show active")" role="tabpanel" aria-labelledby="tab1">
                <!--Tabla de Aprobados-->
                @if (@Model.ListaReintegroVacacionesAprobadas != null && @Model.ListaReintegroVacacionesAprobadas.Count > 0)
                {
                    <table class="table table-striped table-hover" id="tablaFacturas" style="margin-bottom:70px;">
                        <thead>

                            <tr>
                                <th>Num Solicitud</th>
                                <th>Fecha Rige</th>
                                <th>Fecha Vence</th>
                                <th>Cantidad Días</th>
                                <th> <!-- boton detalle--></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.ListaReintegroVacacionesAprobadas.Count; i++)
                            {
                                <tr class="omitir">


                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesAprobadas[i].SolReintegro</td>
                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesAprobadas[i].FechaRige.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesAprobadas[i].FechaVence.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesAprobadas[i].CantidadDias</td>
                                    <td class="border-bottom border-success"><button class="btn btn-outline-info" onclick="abrirDetalles(@(Model.ListaReintegroVacacionesAprobadas[i].IdEntidad), '@(Model.ListaReintegroVacacionesAprobadas[i].SolReintegro)', '@(Model.ListaReintegroVacacionesAprobadas[i].CantidadDias.ToString())', '@(Model.ListaReintegroVacacionesAprobadas[i].FechaRige.ToShortDateString().ToString())','@(Model.ListaReintegroVacacionesAprobadas[i].FechaVence.ToShortDateString().ToString())','@(Model.ListaReintegroVacacionesAprobadas[i].Motivo)','@(Model.ListaReintegroVacacionesAprobadas[i].Observaciones)');" id="btnDetalles"> Detalles  <i class="fa fa-paperclip"></i></button></td>
                                    <td class="border-bottom border-success">
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">No se encontraron Registros de Reintegros Aprobados para el Funcionario </div>
                }
            </div>
            <div id="tabs-2" class="tab-pane fade @(Session["ReintegroActivo"] == null ? "" : "show active")" role="tabpanel" aria-labelledby="tab2">
                <!--Tabla de Pendientes-->
                @if (@Model.ListaReintegroVacacionesPendientes != null && @Model.ListaReintegroVacacionesPendientes.Count > 0)
                {
                    <table class="table table-striped table-hover" id="tablaFacturas" style="margin-bottom:70px;">
                        <thead>

                            <tr>
                                <th>Num Solicitud</th>
                                <th>Fecha Rige</th>
                                <th>Fecha Vence</th>
                                <th>Cantidad Días</th>
                                <th> <!-- boton detalle--></th>
                                <th><!--Boton Anular--></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.ListaReintegroVacacionesPendientes.Count; i++)
                            {
                                <tr class="omitir">


                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesPendientes[i].SolReintegro</td>
                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesPendientes[i].FechaRige.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesPendientes[i].FechaVence.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesPendientes[i].CantidadDias</td>
                                    <td class="border-bottom border-success"><button class="btn btn-outline-info" onclick="abrirDetalles(@(Model.ListaReintegroVacacionesPendientes[i].IdEntidad), '@(Model.ListaReintegroVacacionesPendientes[i].SolReintegro)', '@(Model.ListaReintegroVacacionesPendientes[i].CantidadDias.ToString())', '@(Model.ListaReintegroVacacionesPendientes[i].FechaRige.ToShortDateString().ToString())','@(Model.ListaReintegroVacacionesPendientes[i].FechaVence.ToShortDateString().ToString())','@(Model.ListaReintegroVacacionesPendientes[i].Motivo)','@(Model.ListaReintegroVacacionesPendientes[i].Observaciones)');" id="btnDetalles"> Detalles  <i class="fa fa-paperclip"></i></button></td>
                                    <td class="border-bottom border-success"><button class="btn btn-outline-danger" onclick="abrirCancelarReintegro(@(Model.ListaReintegroVacacionesPendientes[i].IdEntidad), '@(Model.ListaReintegroVacacionesPendientes[i].SolReintegro)', '@(Model.ListaReintegroVacacionesPendientes[i].CantidadDias.ToString())', '@(Model.ListaReintegroVacacionesPendientes[i].FechaRige.ToShortDateString().ToString())','@(Model.ListaReintegroVacacionesPendientes[i].FechaVence.ToShortDateString().ToString())','@(Model.ListaReintegroVacacionesPendientes[i].Motivo)','@(Model.ListaReintegroVacacionesPendientes[i].Observaciones)');" id="btnCancelar"> Anular <i class="fa fa-window-close"></i></button></td>
                                    <td class="border-bottom border-success">
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">No se encontraron Registros de Reintegros Pendientes para el Funcionario </div>
                }

            </div>
            <div id="tabs-3" class="tab-pane fade" role="tabpanel" aria-labelledby="tab3">
                <!--Tabla de Rechazados-->
                @if (@Model.ListaReintegroVacacionesRechazadas != null && @Model.ListaReintegroVacacionesRechazadas.Count > 0)
                {
                    <table class="table table-striped table-hover" id="tablaFacturas" style="margin-bottom:70px;">
                        <thead>

                            <tr>
                                <th>Num Solicitud</th>
                                <th>Fecha Rige</th>
                                <th>Fecha Vence</th>
                                <th>Cantidad Días</th>
                                <th> <!-- boton detalle--></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.ListaReintegroVacacionesRechazadas.Count; i++)
                            {
                                <tr class="omitir">


                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesRechazadas[i].SolReintegro</td>
                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesRechazadas[i].FechaRige.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesRechazadas[i].FechaVence.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesRechazadas[i].CantidadDias</td>
                                    <td class="border-bottom border-success"><button class="btn btn-outline-info" onclick="abrirDetalles(@(Model.ListaReintegroVacacionesRechazadas[i].IdEntidad), '@(Model.ListaReintegroVacacionesRechazadas[i].SolReintegro)', '@(Model.ListaReintegroVacacionesRechazadas[i].CantidadDias.ToString())', '@(Model.ListaReintegroVacacionesRechazadas[i].FechaRige.ToShortDateString().ToString())','@(Model.ListaReintegroVacacionesRechazadas[i].FechaVence.ToShortDateString().ToString())','@(Model.ListaReintegroVacacionesRechazadas[i].Motivo)','@(Model.ListaReintegroVacacionesRechazadas[i].Observaciones)');" id="btnDetalles"> Detalles  <i class="fa fa-paperclip"></i></button></td>
                                    <td class="border-bottom border-success">
                                        @if (Model.ListaReintegroVacacionesRechazadas[i].Estado == 6)
                                        {
                                            <label>En discusión - </label>
                                            <button class="btn btn-warning" onclick="abrirDiscusionReintegro(@(Model.ListaReintegroVacacionesRechazadas[i].IdEntidad),
                                                    '@(Model.ListaReintegroVacacionesRechazadas[i].SolReintegro.ToString())',
                                                    '@(Model.ListaReintegroVacacionesRechazadas[i].CantidadDias.ToString())',
                                                    '@(Model.ListaReintegroVacacionesRechazadas[i].FechaRige.ToShortDateString().ToString())',
                                                    '@(Model.ListaReintegroVacacionesRechazadas[i].FechaVence.ToShortDateString().ToString())',
                                                    '@(Model.Funcionario.Cedula.ToString())',
                                                    '@(Model.Funcionario.Nombre.ToString())',
                                                    '@(Model.Funcionario.PrimerApellido.ToString())',
                                                    '@(Model.Funcionario.SegundoApellido.ToString())');"
                                                    id="btnDiscusion">
                                                <i class="fa fa-reply"></i> Someter a discusion
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">No se encontraron Registros de Reintegros Rechazados para el Funcionario </div>
                }
            </div>

            <div id="tabs-4" class="tab-pane fade" role="tabpanel" aria-labelledby="tab4">
                <!--Tabla de Anulados-->
                @if(@Model.ListaReintegroVacacionesAnuladas != null && @Model.ListaReintegroVacacionesAnuladas.Count > 0)
                {
                    <table class="table table-striped table-hover" id="tablaFacturas" style="margin-bottom:70px;">
                        <thead>

                            <tr>
                                <th>Num Solicitud</th>
                                <th>Fecha Rige</th>
                                <th>Fecha Vence</th>
                                <th>Cantidad Días</th>
                                <th> <!-- boton detalle--></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.ListaReintegroVacacionesAnuladas.Count; i++)
                            {
                                <tr class="omitir">


                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesAnuladas[i].SolReintegro</td>
                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesAnuladas[i].FechaRige.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesAnuladas[i].FechaVence.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaReintegroVacacionesAnuladas[i].CantidadDias</td>
                                    <td class="border-bottom border-success"><button class="btn btn-outline-info" onclick="abrirDetalles(@(Model.ListaReintegroVacacionesAnuladas[i].IdEntidad), '@(Model.ListaReintegroVacacionesAnuladas[i].SolReintegro)', '@(Model.ListaReintegroVacacionesAnuladas[i].CantidadDias.ToString())', '@(Model.ListaReintegroVacacionesAnuladas[i].FechaRige.ToShortDateString().ToString())','@(Model.ListaReintegroVacacionesAnuladas[i].FechaVence.ToShortDateString().ToString())','@(Model.ListaReintegroVacacionesAnuladas[i].Motivo)','@(Model.ListaReintegroVacacionesAnuladas[i].Observaciones)');" id="btnDetalles"> Detalles  <i class="fa fa-paperclip"></i></button></td>
                                    <td class="border-bottom border-success">
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">No se encontraron Registros de Reintegros Anulados para el Funcionario </div>
                }
            </div>
        </div>
    </div>
    <br />
}
else
{
    <div class="alert alert-warning">El Funcionario no presenta ningún Registro Relacionado a Vacaciones</div>
}
<a class="btn btn-primary" href="Index" id="A5"><i class="fa fa-arrow-circle-left"></i> Regresar</a>


<!--MODAL DETALLES-->
<div class="modal fade" id="modal-detalles" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header alert alert-info" role="contentinfo">
                <h5 class="modal-title" id="exampleModalCenterTitle">
                    <i class="fa fa-info-circle d-inline" style="font-size:25px;"></i>
                    Información de la Solicitud de Reintegro <strong id="numDocumento"></strong> del funcionario <strong>@Model.Funcionario.Cedula - @Model.Funcionario.Nombre @Model.Funcionario.PrimerApellido @Model.Funcionario.SegundoApellido</strong>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Ajax.BeginForm("MostrarDetalles", "Vacaciones", new AjaxOptions
            {
                HttpMethod = "Post",
                UpdateTargetId = "dvResultadoCancelado",
                OnBegin = "CancelarDetallesConfirmado",
                OnFailure = "CompleteCancelarDetalles('btnDetalles','preloader')",
                OnComplete = "CompleteCancelarDetalles('btnDetalles','preloader')"
            }, new { @id = "formCancelarRegistro" }))
            {
                <div class="modal-body">
                    <input type="hidden" id="dias" />
                    <input type="hidden" id="idRegistro" name="identRegistro" />

                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Fecha Inicio</th>
                                <th>Fecha Fin</th>
                                <th>Días</th>
                                <th>Motivo</th>
                                <th>Oservaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><div id="fechaSalida"></div></td>
                                <td><div id="fechaEntrada"></div></td>
                                <td><div id="dias"></div></td>
                                <td><div id="motivo"></div></td>
                                <td><div id="observaciones"></div></td>
                            </tr>
                        </tbody>

                    </table>
                    <div id="info" class="alert alert-info" style="display:none"></div>

                    @Html.HiddenFor(model => model.Funcionario.Cedula, new { @id = "cedula" })

                </div>
                <div class="modal-footer"></div>
            }
        </div>
    </div>
</div>

<!--MODAL ANULAR-->
<div class="modal fade" id="modal-cancelar" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header alert alert-danger" role="alert">
                <h5 class="modal-title" id="exampleModalCenterTitle">
                    <i class="fa fa-exclamation-circle d-inline" style="font-size:25px;"></i>
                    ¡Atención! Usted está apunto de anular el Reintegro de vacaciones <strong></strong> del funcionario <strong>@Model.Funcionario.Cedula - @Model.Funcionario.Nombre @Model.Funcionario.PrimerApellido @Model.Funcionario.SegundoApellido</strong>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Ajax.BeginForm("AnularReintegro", "Vacaciones", new AjaxOptions
            {
                HttpMethod = "Post",
                UpdateTargetId = "dvResultadoCancelado",
                OnBegin = "CancelarReintegroConfirmado",
                OnFailure = "CompleteCancelarReintegro('btnCancelar','preloader')",
                OnComplete = "CompleteCancelarReintegro('btnCancelar','preloader')"
            }, new { @id = "formCancelarRegistro" }))
            {
                <div class="modal-body">
                    <input type="hidden" id="dias" />
                    <input type="hidden" id="idRegistro" name="identRegistro" />

                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Fecha Inicio</th>
                                <th>Fecha Fin</th>
                                <th>Días</th>
                                <th>Motivo</th>
                                <th>Oservaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><div id="fechaSalida"></div></td>
                                <td><div id="fechaEntrada"></div></td>
                                <td><div id="dias"></div></td>
                                <td><div id="motivo"></div></td>
                                <td><div id="observaciones"></div></td>
                            </tr>
                        </tbody>

                    </table>
                    <div id="error" class="alert alert-danger" style="display:none">
                    </div>
                    @Html.HiddenFor(model => model.Funcionario.Cedula, new { @id = "cedula" })

                </div>
                <div class="modal-footer">
                    <input name="SubmitButton" class="btn btn-primary" type="submit" value="Guardar" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>

<!--MODAL DISCUSION-->
<div class="modal fade" id="modal-discusion" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header alert alert-warning" role="alert">
                <h5 class="modal-title" id="exampleModalCenterTitle">
                    <i class="fa fa-exclamation-circle d-inline" style="font-size:25px;"></i>
                    ¡Atención! Usted está apunto de someter a discusion el reintegro de vacaciones <strong id="numDocumento"></strong> del funcionario <strong id="cedula"></strong> - <strong id="nomFuncionario"></strong> <strong id="primerApellido"></strong> <strong id="segundoApellido"></strong>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Ajax.BeginForm("ActualizarReintegro", "Vacaciones", new AjaxOptions
            {
                HttpMethod = "Post",
                UpdateTargetId = "dvResultadoDiscusion",
                OnBegin = "DiscusionReintegroConfirmado",
                OnFailure = "CompleteDiscusionReintegro('btndiscusion','preloader')",
                OnComplete = "CompleteDiscusionReintegro('btndiscusion','preloader')"
            }, new { @id = "formDiscusionReintegro" }))
            {
                <div class="modal-body">
                    <input type="hidden" id="Solicitud" name="Solicitud" value="" />
                    <input type="hidden" id="Cedula" name="Cedula" value="" />
                    <strong>Escriba un comentario para someter a discusión el reintegro.</strong>
                    <table class="table table-hover">
                        <tr>
                            <td>Nº Transacción</td>
                            <td>Fecha Rige</td>
                            <td>Fecha Vence</td>
                            <td>Días a reintegrar</td>
                        </tr>

                        <tr>
                            <td><div id="numDocumento"></div></td>
                            <td><div id="fechaSalida"></div></td>
                            <td><div id="fechaEntrada"></div></td>
                            <td><div id="dias"></div></td>
                        </tr>
                    </table>
                    <div class="form-group">
                        <label for="comment"> Comentario: </label>
                        @Html.TextAreaFor(model => model.ReintegroVacaciones.Comentario, new { @class = "form-control", @size = 50, @placeholder = "Comentario" })
                    </div>
                    <div id="error" class="alert alert-danger" style="display:none"></div>
                    @*@Html.HiddenFor(model => model.Periodo.Periodo, new { @id = "periodo" })
        @Html.HiddenFor(model => model.Periodo.IdEntidad, new { @id = "identperiodo" })*@
                    @Html.HiddenFor(model => model.Funcionario.Cedula)
                    @Html.HiddenFor(model => model.Funcionario.Nombre)
                    @Html.HiddenFor(model => model.Funcionario.PrimerApellido)
                    @Html.HiddenFor(model => model.Funcionario.SegundoApellido)
                    @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Seccion.IdEntidad)
                    @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Division.IdEntidad)
                    @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.IdEntidad)
                    @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Departamento.IdEntidad)
                    @Html.HiddenFor(model => model.Funcionario.Cedula, new { @id = "cedula" })
                    @Html.HiddenFor(model => model.PeriodosActivos.Count)
                </div>
                <div class="modal-footer">
                    <input name="SubmitButton" class="btn btn-primary" type="submit" value="Responder" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>


