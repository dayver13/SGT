@model SIRH.Web.ViewModels.FormularioPeriodoVacacionesVM
@{
    <link href="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/js/bootstrap4-toggle.min.js"></script>
    if (Model != null)
    {
        if (Model.ListaFuncionarios.Count == 0)
        {
            <div class="card border-danger">
                <div class="card-header"><strong>La búsqueda contiene los siguientes errores</strong></div>
                <div class="card-body text-danger">
                    <p>No se encontraron resultados para la búsqueda solicitada.</p>
                </div>
            </div>
        }
        else
        {
            <fieldset>
                <legend>Resultados (@Model.ListaFuncionarios.Count)</legend>
                <table class="table">
                    <thead class="thead-light">
                        <tr>
                            @*<th scope="col">#</th>*@
                            <th scope="col">Cédula</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Jefe Inmediato</th>
                            <th scope="col">Jefe Superior</th>
                            <th scope="col" colspan="4">--</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                           
                            @Html.TextBox("codFuncionario", String.Empty, new { @readonly = "readonly", @hidden = "hidden", @class = "form-control" })

                            int cuenta = 0;
                            foreach (var item in Model.ListaFuncionarios)
                            {
                                cuenta++;
                                <tr>
                                    @*<td>
                                        <div>@Html.ActionLink("Ver Detalle", "DetailsFuncionario", "Calificacion", new { @cedula = item.Funcionario.Cedula, @periodo = Model.Periodos }, new { @class = "btn btn-primary btn-sm", @target = "_blank" })</div>
                                    </td>*@
                                    <td>@item.Funcionario.Cedula</td>
                                    <td>@item.Funcionario.Mensaje</td>
                                    <td>
                                        @(item.JefeInmediato.Cedula + " - " + item.JefeInmediato.Mensaje)
                                    </td>
                                    <td>@(item.JefeSuperior.Cedula + " - " + item.JefeSuperior.Mensaje)</td>
                                    <td>
                                        <div style="display: inline">
                                            <div class="link_view"> @Html.ActionLink("Asignar Jefe", "", "Vacaciones", null, new { @onclick = "return CargarDato('" + item.Funcionario.IdEntidad + "');", @type = "button", @class = "btn btn-outline-primary" }) </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="display: inline">
                                            <div class="link_view"> @Html.ActionLink("Eliminar", "", "Vacaciones", null, new { @onclick = "return EliminarJefe('" + item.Funcionario.IdEntidad + "');", @type = "button", @class = "btn btn-danger btn-sm" })</div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            <tr>
                            </tr>
                        }
                    </tbody>
                </table>
            </fieldset>
        }

    }

        <script type="text/javascript">
        function onBeginNew() {
                //alert("algo");
                document.getElementById("form_reportar").submit();
        }
        </script>

        <script src="~/Scripts/Pages/VacacionesJefatura.js" type="text/javascript"></script>
}