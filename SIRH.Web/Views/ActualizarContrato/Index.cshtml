<script>
    function checkSelection(identificador) {
        var select1 = document.getElementById('medios' + identificador).value;
        var select2 = document.getElementById('medible' + identificador).value;
        var select3 = document.getElementById('supervision' + identificador).value;
        var textDiv = document.getElementById('teletrabajable' + identificador);

        if (select1 === 'Sí' && select2 === 'Sí' && select3 === 'Sí') {
            textDiv.innerText = 'Sí';
        } else {
            textDiv.innerText = 'No';
        }
    }
</script>

<script type="text/javascript">
    function ObtenerCantones(idProvincia) {
        $list = $("#cantonSecundario");

        $.ajax({
            type: "post",
            url: "/ActualizarContrato/GetCantones",
            data: { idProvincia: idProvincia },
            datatype: "json",
            traditional: true,
            success: function (data) {
                if (data.success) {
                    $list.empty();
                    $list.append('<option value=0> Selecione... </option>');
                    for (var i = 0; i < data.listado.length; i++) {
                        $list.append('<option value=' + data.listado[i].IdEntidad + '> ' + data.listado[i].NomCanton + ' </option>');
                        console.log(data.listado[i].NomCanton + i);
                    }
                    ObtenerDistritos(data.listado[0].IdEntidad);
                }
                else {
                    alert(data.mensaje);
                }
            },
            error: function (err) {
                alert("Error");
            }
        });
    }

    function ObtenerDistritos(idCanton) {
        $list = $("#distritoSecundario");

        $.ajax({
            type: "post",
            url: "/ActualizarContrato/GetDistritos",
            data: { idCanton: idCanton },
            datatype: "json",
            traditional: true,
            success: function (data) {
                if (data.success) {
                    $list.empty();
                    $list.append('<option value=0> Selecione... </option>');
                    for (var i = 0; i < data.listado.length; i++) {
                        $list.append('<option value=' + data.listado[i].IdEntidad + '> ' + data.listado[i].NomDistrito + ' </option>');
                    }
                }
                else {
                    alert(data.mensaje);
                }
            },
            error: function (err) {
                alert("Error");
            }
        });
    }

    function fueExitoso() {
        var dvalert = document.getElementById("alert");
        var divsucc = document.createElement("div");
        divsucc.className = "success";
        divsucc.innerText = "Envio de solicitud fue exitosa";
        dvalert.appendChild(divsucc);
        setTimeout(function () { window.location.href = "/GestionContrato"; }, 4000);
    }

    function fuefallido() {
        var dvalert = document.getElementById("alert");
        var divsucc = document.createElement("div");
        divsucc.className = "failure";
        divsucc.innerText = "Envio de solicitud fallo, revise que toda la informacin este correcta.";
        dvalert.appendChild(divsucc);
        setTimeout(function () { document.getElementById("alert").innerHTML = ""; }, 3000);
    }

    



</script>


