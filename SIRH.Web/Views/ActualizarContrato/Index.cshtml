@model SIRH.Web.ViewModels.PerfilFuncionarioVM

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Teletrabajo.cshtml";
}

<link rel="stylesheet" href="~/Content/sidebar.css">

<style>
    .success {
        padding: 20px;
        background-color: green; /* Red */
        color: white;
        margin-bottom: 15px;
        opacity: 1;
        transition: opacity 0.6s;
        width: 100%;
    }

    .failure {
        padding: 20px;
        background-color: red; /* Red */
        color: white;
        margin-bottom: 15px;
        opacity: 1;
        transition: opacity 0.6s;
        width: 100%;
    }

    /* The close button */
    .closebtn {
        margin-left: 15px;
        color: white;
        font-weight: bold;
        float: right;
        font-size: 22px;
        line-height: 20px;
        cursor: pointer;
        transition: 0.3s;
    }

        /* When moving the mouse over the close button */
        .closebtn:hover {
            color: black;
        }

    .textarea {
        width: 200px;
    }
</style>

@{
    using (Ajax.BeginForm("NuevaSolicitudTeletrabajo", "ActualizarContrato", new AjaxOptions
    {
        UpdateTargetId = "dvResultadoBusqueda",
        HttpMethod = "POST",
        OnSuccess = "fueExitoso",
        OnFailure = "fuefallido",
        OnBegin = ""
    }))
    {
        <h2>Actualizar Contrato de Teletrabajo</h2>
        <div class="jumbotron">
            <div class="sidebar"></div>
            <main>
               
                <section class="main-content">
                    <div class="user-information">
                        <h2>Información de Colaborador</h2>
                        <ul>
                            <li>Nombre: @Html.DisplayFor(model => model.Funcionario.Nombre) @Html.DisplayFor(model => model.Funcionario.PrimerApellido) @Html.DisplayFor(model => model.Funcionario.SegundoApellido)</li>
                            <li>Departamento: @Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento) </li>
                            <li>Puesto: @Html.DisplayFor(model => model.Puesto.CodPuesto)</li>
                        </ul>
                    </div>
                    <div class="form-area">
                        <h2>Datos de la Petición</h2>
                        <form action="">
                            <div id="direccion" class="section">
                                <details>
                                    <summary>Dirección Secundaria</summary>
                                    <table class="table table-hover">
                                        <tbody>
                                            <tr>
                                                <th>@Html.LabelFor(model => model.Direccion.Distrito.Canton.Provincia.NomProvincia) </th>
                                                <td>@Html.DisplayFor(model => model.ProvinciaSeleccionada) </td>
                                                <th>@Html.LabelFor(model => model.Direccion.Distrito.Canton.NomCanton) </th>
                                                <td>@Html.DisplayFor(model => model.CantonSeleccionado)</td>
                                                <th>@Html.LabelFor(model => model.Direccion.Distrito.NomDistrito) </th>
                                                <td>@Html.DisplayFor(model => model.DistritoSeleccionado)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <table class="table table-hover">
                                        <tbody>
                                            <tr>

                                                <th style="width:200px;">
                                                    @Html.LabelFor(model => model.Direccion.DirExacta)
                                                </th>
                                                <td> @Html.DisplayFor(model => model.SolicitudTeletrabajo.DireccionExactaSecundaria)</td>

                                            </tr>
                                        </tbody>
                                    </table>
                                    <table class="table table-hover">
                                        <tbody>
                                            <tr>
                                                <th>Provincia de Lugar de Teletrabajo</th>
                                                <td>
                                                    @Html.DropDownListFor(model => model.ProvinciaSeleccionada,
                                     Model.ListaProvincia, "Selecione...",
                                     new
                                     {
                                         @class = "form-control",
                                         @id = "provinciaSecundario",
                                         @onchange = "ObtenerCantones(this.value)"
                                     })
                                                </td>
                                                <th>Cantón de Lugar de Teletrabajo</th>
                                                <td>
                                                    @Html.DropDownListFor(model => model.CantonSeleccionado,
                                                                                    Model.ListaCantones, "Selecione...",
                                                                                    new
                                                                                    {
                                                                                        @class = "form-control",
                                                                                        @id = "cantonSecundario",
                                                                                        @onchange = "ObtenerDistritos(this.value)"
                                                                                    })
                                                </td>
                                                <th>Distrito de Lugar de Teletrabajo</th>
                                                <td>
                                                    @Html.DropDownListFor(model => model.DistritoSeleccionado,
                                                                                    Model.ListaDistritos, "Selecione...",
                                                                                    new
                                                                                    {
                                                                                        @class = "form-control",
                                                                                        @id = "distritoSecundario",
                                                                                        @name = "distritoSecundario"
                                                                                    })
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <table class="table table-hover">
                                        <tbody>
                                            <tr>
                                                <th style="width:200px;">
                                                    @Html.LabelFor(model => model.Direccion.DirExacta)
                                                </th>
                                                <td style="width:600px;">@Html.TextAreaFor(model => model.SolicitudTeletrabajo.DireccionExactaSecundaria, new { style = "width: 100%;", rows = "5" })</td>

                                            </tr>
                                        </tbody>
                                    </table>
                                    <div><label>¿Desea agregar un lugar de Teletrabajo Secundario? </label></div>
                                    <div>
                                        <input type="radio" name="secundario" value="1" checked onclick="toggleTextBox()" /> <label style="margin-right: 10px;">Sí</label>
                                        <input type="radio" name="secundario" value="0" onclick="toggleTextBox()" /> <label>No</label>
                                    </div>
                                    <div>
                                        @Html.LabelFor(model => model.SolicitudTeletrabajo.CantidadPersonasDireccionSecundaria)
                                        @Html.TextBoxFor(model => model.SolicitudTeletrabajo.CantidadPersonasDireccionSecundaria, new { @id = "personasSecundario", @type = "number" })
                                    </div>

                                </details>
                            </div>
                            <div id="funciones" class="section">
                                <details>
                                    <summary>Funciones</summary>
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Actividades</th>
                                                <th>Accion</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tablaDatos">
                                        </tbody>
                                    </table>
                                    <div class="card-body">
                                        <div id="registros">
                                        </div>
                                        <center>
                                            <button type="button" id="AgregarCompetencia" class="btn btn-outline-info" onclick=cargarcampofuncion()><i class="fa fa-plus-circle"></i> Agregar Actividad</button>
                                        </center>
                                        <div id="activate">

                                        </div>
                                    </div>
                                </details>
                            </div>
                            <div id="dias" class="section">
                                <details>
                                    <summary>Días en teletrabajo</summary>
                                    <table class="table table-hover">
                                        <tbody>
                                            <tr>
                                                <th>Cantidad de días aprobados</th>
                                                <td>@Html.DisplayFor(model => model.SolicitudTeletrabajo.CantidadDiasTeletrabajo) </td>
                                            </tr>
                                            <tr>
                                                <th>Cantidad nueva:</th>
                                                <td>@Html.TextBoxFor(model => model.SolicitudTeletrabajo.CantidadDiasTeletrabajo, new { @type = "number", @min = "1", @max = "4", @id = "cantDias", @onchange = "updateMaxCheckboxes()" })</td>
                                            </tr>
                                            <tr>
                                                <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.DetalleDiasTeletrabajo) </th>
                                                <td>
                                                    @if (Model.SolicitudTeletrabajo.DetalleDiasTeletrabajo.Contains("Lunes"))
                                                    {
                                                        <input type="checkbox" id="lunes" name="lunes" value="Lunes" class="limited-dias" onclick="limitCheckboxes()" checked>}
                                                    else
                                                    {<input type="checkbox" id="lunes" name="lunes" value="Lunes" class="limited-dias" onclick="limitCheckboxes()">}
                                                    <label for="lunes">Lunes</label><br>
                                                    @if (Model.SolicitudTeletrabajo.DetalleDiasTeletrabajo.Contains("Martes"))
                                                    {
                                                        <input type="checkbox" id="martes" name="martes" value="Martes" class="limited-dias" onclick="limitCheckboxes()" checked>}
                                                    else
                                                    {<input type="checkbox" id="martes" name="martes" value="Martes" class="limited-dias" onclick="limitCheckboxes()">}
                                                    <label for="martes">Martes</label><br>
                                                    @if (Model.SolicitudTeletrabajo.DetalleDiasTeletrabajo.Contains("Miercoles"))
                                                    {
                                                        <input type="checkbox" id="miercoles" name="miercoles" value="Miercoles" class="limited-dias" onclick="limitCheckboxes()" checked>}
                                                    else
                                                    {<input type="checkbox" id="miercoles" name="miercoles" value="Miercoles" class="limited-dias" onclick="limitCheckboxes()">}
                                                    <label for="miercoles">Miércoles</label><br>
                                                    @if (Model.SolicitudTeletrabajo.DetalleDiasTeletrabajo.Contains("Jueves"))
                                                    {
                                                        <input type="checkbox" id="jueves" name="jueves" value="Jueves" class="limited-dias" onclick="limitCheckboxes()" checked>}
                                                    else
                                                    {<input type="checkbox" id="jueves" name="jueves" value="Jueves" class="limited-dias" onclick="limitCheckboxes()">}
                                                    <label for="jueves">Jueves</label><br>
                                                    @if (Model.SolicitudTeletrabajo.DetalleDiasTeletrabajo.Contains("Viernes"))
                                                    {
                                                        <input type="checkbox" id="viernes" name="viernes" value="Viernes" class="limited-dias" onclick="limitCheckboxes()" checked>}
                                                    else
                                                    {<input type="checkbox" id="viernes" name="viernes" value="Viernes" class="limited-dias" onclick="limitCheckboxes()">}
                                                    <label for="viernes">Viernes</label><br>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </details>
                            </div>
                            <div class="col-2">
                                <button class="btn btn-success " id="btnEnviar" name="SubmitButton" type="submit" value="Enviar nueva solicitud">
                                    <i class="fa fa-save"></i>
                                    Enviar nueva solicitud
                                </button>
                            </div>
                        </form>
                        <div id="alert">
                        </div>
                    </div>

                </section>
            </main>

            <footer>
                <div>
                    <div class="footer-content"></div>
                </div>
            </footer>
        </div>
    }
}

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")

<script src="~/Scripts/sidebar.js" type="text/javascript"></script>
<script src="~/Scripts/Pages/DetailsFuncionario.js" type="text/javascript"></script>
<script src="~/Scripts/Pages/FormularioSolicitudTeletrabajo.js" type="text/javascript"></script>
<script src="~/scripts/jquery.unobtrusive-ajax.js" type="text/javascript"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>

<script>
    function cargaractividades() {
        $.ajax({
            type: "get",
            url: "/ActualizarContrato/DescargarActividades", // Ruta al archivo CSV
            dataType: "text", // Indicar que se espera texto
        }).done(function (data) {
            console.error(data)
            const filas = data.split('\n'); // Dividir en líneas
            const tbody = document.getElementById('tablaDatos');
            tbody.innerHTML = "";
            var i;

            // Iterar sobre las filas y agregar datos a la tabla
            if (filas.length > 1) {
                for (i = 1; i < filas.length - 1; i++) {
                    let id;
                    // Saltar la primera fila (encabezados) y líneas vacías
                    const nuevaFila = document.createElement("tr") // Crear nueva fila
                    const nuevaCelda = document.createElement("td");
                    const celdaboton = document.createElement("td");
                    const boton = document.createElement("button");
                    boton.type = "button";
                    boton.innerText = "Eliminar";
                    boton.className = "btn btn-success ";
                    id = filas[i];
                    boton.addEventListener('click', function () { eliminarElemento(id); });
                    nuevaCelda.appendChild(document.createTextNode(filas[i]));
                    nuevaFila.appendChild(nuevaCelda);
                    celdaboton.appendChild(boton);
                    nuevaFila.appendChild(celdaboton);
                    tbody.appendChild(nuevaFila); // Agregar fila al tbody
                }
            };
        }).fail(function (jqXHR, textStatus, errorThrown) {
            console.error('Error al cargar el archivo CSV:', textStatus, errorThrown);
        }
        );
    };

    window.addEventListener('load', cargaractividades());
    

    function eliminarElemento(id) {
        $.ajax({
            type: "post",
            url: `/ActualizarContrato/EliminarActividad?actividad=${id}`,
            datatype: "text",
            success: function (response) {
                console.error('Elemento eliminado con éxito');
                cargaractividades();

            },
            error: function (xhr) {
                console.error('Error al eliminar el elemento: ' + xhr.responseText);
            }
        });
    };

    function cargarcampofuncion() {
        const divplace = document.getElementById("activate");
        divplace.innerHTML = "";
        const table = document.createElement("table");
        const tbody = document.createElement("tbody");
        const trtable = document.createElement("tr");
        const tddescrip = document.createElement("td");
        tddescrip.innerText = "Actividad:";
        const tdtext = document.createElement("td");
        const textarea = document.createElement("textarea");
        textarea.style.width = "100%";
        textarea.rows = 5;
        textarea.id = "detallecampo";
        tdtext.appendChild(textarea);
        trtable.appendChild(tddescrip);
        trtable.appendChild(tdtext);
        tbody.appendChild(trtable);
        const trchck = document.createElement("tr");
        const trchck2 = document.createElement("tr");
        const tdmedios = document.createElement("td");
        const chckmedios = document.createElement("input");
        chckmedios.type = "checkbox";
        chckmedios.id = "medioscampos";
        tdmedios.innerText = "¿Se realiza por medios telemáticos?";
        tdmedios.appendChild(chckmedios);
        const tdmedible = document.createElement("td");
        const chckmedible = document.createElement("input");
        chckmedible.type = "checkbox";
        chckmedible.id = "mediblecampos";
        tdmedible.innerText = "¿Es medible?";
        const tdsupervision = document.createElement("td");
        const chcksupervision = document.createElement("input");
        chcksupervision.type = "checkbox";
        chcksupervision.id = "supervisioncampos";
        tdsupervision.innerText = "¿Se puede realizar con supervisión indirecta, no presencial?";
        tdmedible.appendChild(chckmedible);
        tdsupervision.appendChild(chcksupervision);
        trchck.appendChild(tdmedios);
        trchck.appendChild(tdmedible);
        trchck2.appendChild(tdsupervision);
        const trbotones = document.createElement("tr");
        const celdaboton1 = document.createElement("td");
        const boton = document.createElement("button");
        boton.type = "button";
        boton.innerText = "Cancelar";
        boton.className = "btn btn-success ";
        boton.addEventListener('click', function () { document.getElementById("activate").innerHTML = ""; });
        celdaboton1.appendChild(boton);
        const celdaboton2 = document.createElement("td");
        const boton2 = document.createElement("button");
        boton2.type = "button";
        boton2.innerText = "Agregar";
        boton2.className = "btn btn-success ";
        boton2.addEventListener('click', function () { AgregarElemento(); });
        celdaboton2.appendChild(boton2);
        trbotones.appendChild(celdaboton2);
        trbotones.appendChild(celdaboton1);
        tbody.appendChild(trchck);
        tbody.appendChild(trchck2);
        tbody.appendChild(trbotones);
        table.className = "table table-hover";
        table.appendChild(tbody);
        divplace.appendChild(table);
        var divalert = document.createElement("div");
        divalert.id = "alertF";
        divplace.appendChild(divalert);

    }

    function AgregarElemento() {
        var desc = document.getElementById("detallecampo").value;
        var medible = document.getElementById("mediblecampos").checked;
        var medios = document.getElementById("medioscampos").checked;
        var supervision = document.getElementById("supervisioncampos").checked;
        if (medible && medios && supervision) {
            $.ajax({
                type: "post",
                url: `/ActualizarContrato/AgregarActividad?actividad=${desc}&medios=${medios}&medible=${medible}&supervision=${supervision}`,
                datatype: "text",
                success: function (response) {
                    console.error('Elemento agregado con éxito');
                    cargaractividades();
                    const divplace = document.getElementById("activate");
                    divplace.innerHTML = "";

                },
                error: function (xhr) {
                    console.error('Error al eliminar el elemento: ' + xhr.responseText);
                }
            });
        } else {
            fuefallidof()
        }
    };

    function fuefallidof() {
        var dvalert = document.getElementById("alertF");
        var divsucc = document.createElement("div");
        divsucc.className = "failure";
        divsucc.innerText = "La actividad debe cumplir con los 3 requisitos para ser teletrabajable";
        dvalert.appendChild(divsucc);
        setTimeout(function () { document.getElementById("alertF").innerHTML = ""; }, 3000);
    }

    function toggleTextBox() {
        var option1 = document.getElementById("secundarioNo");
        var textBox = document.getElementById("senasSecundario");
        var prov = document.getElementById("provinciaSecundario");
        var cant = document.getElementById("cantonSecundario");
        var dist = document.getElementById("distritoSecundario");
        var personas = document.getElementById("personasSecundario");
        if (option1.checked) {
            textBox.disabled = true;
            prov.disabled = true;
            cant.disabled = true;
            dist.disabled = true;
            personas.disabled = true;
        } else {
            textBox.disabled = false;
            prov.disabled = false;
            cant.disabled = false;
            dist.disabled = false;
            personas.disabled = false;
        }
    }

    function updateMaxCheckboxes() {
        limitCheckboxes(); // Ensure the limit is enforced when the max value changes
    }

    function limitCheckboxes() {
        let maxCheckboxes = document.getElementById('cantDias').value;
        let checkboxes = document.querySelectorAll('.limited-dias');
        let checkedCount = 0;

        checkboxes.forEach(checkbox => {
            if (checkbox.checked) {
                checkedCount++;
            }
        });

        if (checkedCount < maxCheckboxes) {
            checkboxes.forEach(checkbox => {
                checkbox.disabled = false;
            });
        } else {
            if (checkedCount > maxCheckboxes) {
                checkboxes.forEach(checkbox => {
                    checkbox.disabled = false;
                    if (checkbox.checked) {
                        checkbox.checked = false;
                    }
                });
            } else {
                if (checkedCount = maxCheckboxes) {
                    checkboxes.forEach(checkbox => {
                        if (!checkbox.checked) {
                            checkbox.disabled = true;
                        }
                    });
                }
            }
        }
    }

    window.addEventListener('load', limitCheckboxes());


    // Ensure the correct state on page load
    document.addEventListener("DOMContentLoaded", function () {
        toggleTextBox();
       
    });
</script>

