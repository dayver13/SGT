@model SIRH.Web.ViewModels.PerfilFuncionarioVM
@{
    ViewBag.Title = "Módulo de Jefatura - Actualizar Aval";
    Layout = "~/Views/Shared/ModuloJefatura.cshtml";
}

<link rel="stylesheet" href="~/Content/sidebar.css">
<style>
    .success {
        padding: 20px;
        background-color: green;
        color: white;
        margin-bottom: 15px;
        opacity: 1;
        transition: opacity 0.6s;
        width: 100%;
    }

    .form-area {
        margin: 20px;
    }

    /* Modal Styles */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        justify-content: center;
        align-items: center;
        z-index: 999;
    }

    .modal-content {
        background: white;
        padding: 20px;
        border-radius: 8px;
        width: 400px;
        position: relative;
        box-shadow: 0 0 10px rgba(0,0,0,0.3);
    }

        .modal-content h3 {
            margin-top: 0;
        }

    .close-button {
        position: absolute;
        top: 10px;
        right: 10px;
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
    }

    .error-message {
        color: red;
        font-size: 14px;
        margin-top: 5px;
        display: none;
    }

    .modal-footer {
        margin-top: 15px;
        text-align: right;
    }
</style>

<h2>Actualizar Aval de Solicitud de Teletrabajo</h2>

@if ((int)Session["FamiliaPuesto"] == 3)
{
    <div>
        Acceso Restringido
    </div>
}
else
{
    using (Html.BeginForm("Index", "ModuloJefatura", FormMethod.Get))
    {
        <div class="form-group">
            <label for="idSolicitud">Solicitudes Pendientes</label>
            <ul>
                @Html.DropDownListFor(model => model.personalseleccionado,
                     Model.personal, "Seleccione Funcionario",
                     new
                     {
                         @class = "form-control",
                         @readonly = "readonly",
                         @id = "personalseleccionado",
                         @onchange = "cargarsolicitud(this.value)"
                     })
            </ul>
        </div>
    }

    if (ViewBag.Message != null)
    {
        <div class="success">@ViewBag.Message</div>
    }

    using (Ajax.BeginForm("ActualizarAval", "ModuloJefatura", new AjaxOptions
    {
        UpdateTargetId = "dvResultadoBusqueda",
        HttpMethod = "POST",
        OnSuccess = "fueExitoso",
        OnFailure = "fuefallido",
        OnBegin = ""
    }))
    {
        <div class="form-area">
            <h3>Datos del Colaborador</h3>
            <ul>
                <li>
                    <label id="cedula">N° Cédula:</label>
                </li>
            </ul>

            <h3>Detalles de la Solicitud</h3>
            <table class="table table-hover">
                <tr>
                    <th>Dirección Secundaria</th>
                    <td><label id="distrito"></label></td>
                    <td><label id="dir"></label>
                    <td>
                </tr>
                <tr>
                    <th>Cantidad de Días de Teletrabajo</th>
                    <td><label id="cantd"></label></td>
                </tr>
                <tr>
                    <th>Detalle de Días</th>
                    <td><label id="detalled"></label></td>
                </tr>
            </table>

            <h3>Actualizar Aval</h3>
            <div class="form-group">
                @if ((int)Session["FamiliaPuesto"] == 1)
                {
                    <label for="AvalInmediata">Aval de Jefatura Superior (Aprobar Solicitud):</label>
                    <input type="checkbox" name="aval" id=" aval" value="1">
                }
                @if ((int)Session["FamiliaPuesto"] == 2)
                {
                    <label for="AvalInmediata">Aval de Jefatura Inmediata (Aprobar Solicitud):</label>
                    <input type="checkbox" name="aval" id="aval" value="1">
                }
            </div>
          
            <div class="form-group">
                <label>Comentarios:</label>
                <textarea id="comentarios" name="comentarios" rows="4" cols="50"></textarea>
            </div>
           


            <button type="submit" class="btn btn-success">Aprobar Aval</button>
            <button type="submit" class="btn btn-danger">Rechazar Aval</button>
        </div>
        <div id="alert"></div>
    }

    <div class="modal-overlay" id="modalRechazo">
        <div class="modal-content">
            <button class="close-button" id="cerrarModal">&times;</button>
            <h3>Rechazar Aval</h3>
            <label for="comentarioRechazo">Comentarios de Corrección (obligatorio):</label>
            <textarea id="comentarioRechazo" class="form-control" rows="4" placeholder="Ingrese el motivo de rechazo..."></textarea>
            <div class="error-message" id="comentarioError">El comentario es obligatorio para rechazar.</div>
            <div class="modal-footer">
                <button type="button" id="cancelarModal" class="btn">Cancelar</button>
                <button type="button" id="guardarRechazo" class="btn btn-danger">Guardar Rechazo</button>
            </div>
        </div>
    </div>
}

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")

<script src="~/Scripts/sidebar.js" type="text/javascript"></script>
<script src="~/Scripts/Pages/DetailsFuncionario.js" type="text/javascript"></script>
<script src="~/Scripts/Pages/FormularioSolicitudTeletrabajo.js" type="text/javascript"></script>
<script src="~/scripts/jquery.unobtrusive-ajax.js" type="text/javascript"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const btnRechazo = document.getElementById('btnRechazo');
        const modal = document.getElementById('modalRechazo');
        const cerrarModal = document.getElementById('cerrarModal');
        const cancelarModal = document.getElementById('cancelarModal');
        const guardarRechazo = document.getElementById('guardarRechazo');
        const comentarioInput = document.getElementById('comentarioRechazo');
        const comentarioError = document.getElementById('comentarioError');

        btnRechazo.addEventListener('click', function () {
            modal.style.display = 'flex';
        });

        cerrarModal.addEventListener('click', function () {
            modal.style.display = 'none';
            comentarioError.style.display = 'none';
            comentarioInput.value = '';
        });

        cancelarModal.addEventListener('click', function () {
            modal.style.display = 'none';
            comentarioError.style.display = 'none';
            comentarioInput.value = '';
        });

        guardarRechazo.addEventListener('click', function () {
            const comentario = comentarioInput.value.trim();
            if (comentario === '') {
                comentarioError.style.display = 'block';
                return;
            } else {
                comentarioError.style.display = 'none';
            }

            document.querySelector('textarea[name="SolicitudTeletrabajo.ComentarioAval"]').value = comentario;
            document.querySelector('input[name="SolicitudTeletrabajo.AprobadoJefaturaInmediata"]').checked = false;
            document.querySelector('input[name="SolicitudTeletrabajo.AprobadoJefaturaSuperior"]').checked = false;

            modal.style.display = 'none';
            document.getElementById('formAval').submit();
        });


    });

    function cargarsolicitud(idfuncionario) {
        $.ajax({
            type: "post",
            url: "/ModuloJefatura/GetSolicitud",
            data: { idfuncionario: idfuncionario },
            datatype: "json",
            traditional: true,
            success: function (data) {
                if (data.success) {
                    document.getElementById("cedula").innerText = data.cedula + " - " + data.nombre;
                    document.getElementById("distrito").innerText = data.distrito;
                    document.getElementById("dir").innerText = data.direccion;
                    document.getElementById("cantd").innerText = data.dias;
                    document.getElementById("detalled").innerText = data.detalle;
                    if (data.aprjefe) {
                        document.getElementById("aval").checked = true;
                    }
                    if (data.aprsup) {
                        document.getElementById("aval").checked = true;
                    }
                    document.getElementById("comentarios").value = data.comentarios;
                }
                else {
                    alert(data.mensaje);
                }
            },
            error: function (err) {
                alert("Error");
            }
        });
    }

    function fueExitoso(response) {
        var dvalert = document.getElementById("alert");
        var divsucc = document.createElement("div");
        divsucc.className = "success";
        divsucc.innerText = response.mensaje;
        dvalert.appendChild(divsucc);
        setTimeout(function () { window.location.href = "/ModuloJefatura/"; }, 4000);
    }

    function fuefallido(response) {
        var dvalert = document.getElementById("alert");
        var divsucc = document.createElement("div");
        divsucc.className = "failure";
        divsucc.innerText = response.mensaje;
        dvalert.appendChild(divsucc);
        setTimeout(function () { document.getElementById("alert").innerHTML = ""; }, 3000);
    }
</script>