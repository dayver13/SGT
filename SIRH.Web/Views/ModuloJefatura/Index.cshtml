    function cargarsolicitud(idfuncionario) {
        $.ajax({
            type: "post",
            url: "/ModuloJefatura/GetSolicitud",
            data: { idfuncionario: idfuncionario },
            datatype: "json",
            traditional: true,
            success: function (data) {
                if (data.success) {
                    document.getElementById("cedu").innerText = data.cedula;
                    document.getElementById("solid").innerText = "Solicitud: " + data.id;
                    document.getElementById("distrito").innerText = data.distrito;
                    document.getElementById("dir").innerText = data.direccion;
                    document.getElementById("distritop").innerText = data.distritop;
                    document.getElementById("dirp").innerText = data.direccionp;
                    document.getElementById("cantd").innerText = data.dias;
                    document.getElementById("detalled").innerText = data.detalle;
                    document.getElementById("perp").innerText = data.perpri;
                    document.getElementById("pers").innerText = data.persecu;
                    document.getElementById("tiempm").innerText = data.tiempom;
                    document.getElementById("tiempd").innerText = data.tiempod;
                    document.getElementById("hora").innerText = data.hora;
                    document.getElementById("func").innerText = data.funciones;
                    document.getElementById("sist").innerText = data.sistemas;
                    document.getElementById("raz").innerText = data.razones;
                    if (data.aprjefe) {
                        document.getElementById("aval").checked = true;
                    }
                    if (data.aprsup) {
                        document.getElementById("aval").checked = true;
                    }
                    document.getElementById("comentarios").value = data.comentarios;
                    cargaractividades(data.id);
                }
                else {
                    alert(data.mensaje);
                }
            },
            error: function (err) {
                alert("Error");
            }
        });
    }

    function cargaractividades(id) {
        $.ajax({
            type: "post",
            url: "/ModuloJefatura/DescargarActividades", // Ruta al archivo CSV
            data: { id: id },
            datatype: "text",
            traditional: true,
            success: function (data) {
                if (data.success) {
                    const tbody = document.getElementById('tablaDatos');
                    tbody.innerHTML = "";
                    
                    for (var i = 0; i < data.listado.length; i++) {
                        const nuevaFila = document.createElement("tr") // Crear nueva fila
                        const nuevaCelda = document.createElement("td");
                        nuevaCelda.appendChild(document.createTextNode(data.listado[i].DescripcionActividad));
                        nuevaFila.appendChild(nuevaCelda);
                        tbody.appendChild(nuevaFila); // Agregar fila al tbody
                    }
                }
                else {
                    alert(data.mensaje);
                }
            },
            error: function (err) {
                alert("Error");
            }
         });
    }

    function fueExitoso(response) {
        var dvalert = document.getElementById("alert");
        var divsucc = document.createElement("div");
        divsucc.className = "success";
        divsucc.innerText = response.mensaje;
        dvalert.appendChild(divsucc);
        setTimeout(function () { window.location.href = "/ModuloJefatura/"; }, 4000);
    }

    function aprobar() {
        var comentario = document.getElementById("comentarios").value
        if (comentario === "") {
            var dvalert = document.getElementById("alert");
            var divsucc = document.createElement("div");
            divsucc.className = "failure";
            divsucc.innerText = "Comantarios necesarios para aprobacion";
            dvalert.appendChild(divsucc);
            setTimeout(function () { document.getElementById("alert").innerHTML = ""; }, 3000);
        }else {
            $.ajax({
                type: "post",
                url: "/ModuloJefatura/ActualizarAval", // Ruta al archivo CSV
                data: { aval: "1", comentarios: comentario},
                datatype: "json",
                traditional: true,
                success: function (data) {
                    if (data.success) {
                        var dvalert = document.getElementById("alert");
                        var divsucc = document.createElement("div");
                        divsucc.className = "success";
                        divsucc.innerText = data.respuesta;
                        dvalert.appendChild(divsucc);
                        setTimeout(function () { window.location.href = "/ModuloJefatura/"; }, 4000);
                    }
                    else {
                        var dvalert = document.getElementById("alert");
                        var divsucc = document.createElement("div");
                        divsucc.className = "failure";
                        divsucc.innerText = data.respuesta;
                        dvalert.appendChild(divsucc);
                        setTimeout(function () { document.getElementById("alert").innerHTML = ""; }, 3000);
                    }
                },
                error: function (err) {
                    alert("Error");
                }
            });
        }
    }

    function rechazar() {
        var comentario = document.getElementById("comentarios").value
        if (comentario === "") {
            var dvalert = document.getElementById("alert");
            var divsucc = document.createElement("div");
            divsucc.className = "failure";
            divsucc.innerText = "Comantarios necesarios para aprobacion";
            dvalert.appendChild(divsucc);
            setTimeout(function () { document.getElementById("alert").innerHTML = ""; }, 3000);
        } else {
            $.ajax({
                type: "post",
                url: "/ModuloJefatura/ActualizarAval", // Ruta al archivo CSV
                data: { aval: "0", comentarios: comentario },
                datatype: "json",
                traditional: true,
                success: function (data) {
                    if (data.success) {
                        var dvalert = document.getElementById("alert");
                        var divsucc = document.createElement("div");
                        divsucc.className = "success";
                        divsucc.innerText = data.respuesta;
                        dvalert.appendChild(divsucc);
                        setTimeout(function () { window.location.href = "/ModuloJefatura/"; }, 4000);
                    }
                    else {
                        var dvalert = document.getElementById("alert");
                        var divsucc = document.createElement("div");
                        divsucc.className = "failure";
                        divsucc.innerText = data.respuesta;
                        dvalert.appendChild(divsucc);
                        setTimeout(function () { document.getElementById("alert").innerHTML = ""; }, 3000);
                    }
                },
                error: function (err) {
                    alert("Error");
                }
            });
        }
    }

    function fuefallido(response) {
        var dvalert = document.getElementById("alert");
        var divsucc = document.createElement("div");
        divsucc.className = "failure";
        divsucc.innerText = response.mensaje;
        dvalert.appendChild(divsucc);
        setTimeout(function () { document.getElementById("alert").innerHTML = ""; }, 3000);
    }
</script>