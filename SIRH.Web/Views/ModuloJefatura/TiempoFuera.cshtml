@model SIRH.Web.ViewModels.PerfilFuncionarioVM

@{
    ViewBag.Title = "TiempoFuera";
    Layout = "~/Views/Shared/ModuloJefatura.cshtml";
}

<link rel="stylesheet" href="~/Content/sidebar.css">

<style>
    .success {
        padding: 20px;
        background-color: green; /* Red */
        color: white;
        margin-bottom: 15px;
        opacity: 1;
        transition: opacity 0.6s;
        width: 100%;
    }

    .failure {
        padding: 20px;
        background-color: red; /* Red */
        color: white;
        margin-bottom: 15px;
        opacity: 1;
        transition: opacity 0.6s;
        width: 100%;
    }

    /* The close button */
    .closebtn {
        margin-left: 15px;
        color: white;
        font-weight: bold;
        float: right;
        font-size: 22px;
        line-height: 20px;
        cursor: pointer;
        transition: 0.3s;
    }

        /* When moving the mouse over the close button */
        .closebtn:hover {
            color: black;
        }

    .textarea {
        width: 200px;
    }
</style>

@{
    if ((int)Session["FamiliaPuesto"] == 3)
    {
        <div>
            Acceso Restringido
        </div>
    }
    else
    {
        using (Ajax.BeginForm("NuevoRegistro", "ModuloJefatura", new AjaxOptions
        {
            UpdateTargetId = "dvResultadoBusqueda",
            HttpMethod = "POST",
            OnSuccess = "fueExitoso",
            OnFailure = "fuefallido",
            OnBegin = ""
        }))
        {
            <h2>Registrar Tiempo Fuera</h2>
            <div class="jumbotron">
                <div class="sidebar"></div>
                <main>
                    <section class="main-content">
                        <div class="user-information">
                            <h2>Seleccione Colaborador</h2>
                            <ul>
                                @Html.DropDownListFor(model => model.personalseleccionado,
                         Model.personal, "Selecione Funcionario",
                         new
                         {
                             @class = "form-control",
                             @readonly = "readonly",
                             @id = "personalseleccionado"
                         })
                            </ul>
                        </div>
                        <div class="form-area">
                            <h2>Datos de Salida</h2>
                            <form action="">
                                <div id="tiempo" class="section">
                                    <table class="table table-hover">
                                        <tbody>
                                            <tr>
                                                <th>Fecha Inicio:</th>
                                                <td><input name="StartDate" id="StartDate" type="date" class="form-control" lang="es"/></td>
                                            </tr>
                                            <tr>
                                                <th>Cantidad de Días:</th>
                                                <td><input name="cantidadDias" id="cantidadDias" type="number" step="0.5" class="form-control" min="0.5" oninput=calcularFechaFinal() /></td>
                                            </tr>
                                            <tr>
                                                <th>Fecha Final:</th>
                                                <td><input type="date" id="EndDate" name="EndDate" class="form-control" lang="es"/></td>
                                            </tr>
                                            <tr>
                                                <th>Tipo de salida:</th>
                                                <td>
                                                    @Html.DropDownListFor(model => model.TipoSalidaSeleccionada,
                     Model.TiposSalida, "Seleccione...", new
                     {
                         @class = "form-control",
                         @readonly = "readonly",
                         @id = "tipo"

                     })
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-2">
                                    <button class="btn btn-success " id="btnEnviar" name="SubmitButton" type="submit" value="Registrar Tiempo Fuera">
                                        <i class="fa fa-save"></i>
                                        Registrar Tiempo Fuera
                                    </button>
                                </div>
                            </form>
                            <div id="alert">
                            </div>
                        </div>

                    </section>
                </main>

                <footer>
                    <div>
                        <div class="footer-content"></div>
                    </div>
                </footer>
            </div>
            }
        }
    }

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script src="~/Scripts/sidebar.js" type="text/javascript"></script>
    <script src="~/Scripts/Pages/DetailsFuncionario.js" type="text/javascript"></script>
    <script src="~/Scripts/Pages/FormularioSolicitudTeletrabajo.js" type="text/javascript"></script>
    <script src="~/scripts/jquery.unobtrusive-ajax.js" type="text/javascript"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>

    <script>

        function fueExitoso(response) {
            var dvalert = document.getElementById("alert");
            var divsucc = document.createElement("div");
            divsucc.className = "success";
            divsucc.innerText = response.mensaje;
            dvalert.appendChild(divsucc);
            setTimeout(function () { window.location.href = "/ModuloJefatura/TiempoFuera"; }, 4000);
        }

        function fuefallido(response) {
            var dvalert = document.getElementById("alert");
            var divsucc = document.createElement("div");
            divsucc.className = "failure";
            divsucc.innerText = response.mensaje;
            dvalert.appendChild(divsucc);
            setTimeout(function () { document.getElementById("alert").innerHTML = ""; }, 3000);
        }

        function validarFechas(event) {
            var fechaInicio = document.getElementById("StartDate").value;
            var fechaFin = document.getElementById("EndDate").value;
            var tipo = document.getElementById("tipo").value;

            if (tipo != 1 && tipo != 2) { 
                alert("Debe seleccionar tipo de salida.");
                event.preventDefault();
                return;
            }

            if (!fechaInicio || !fechaFin) {
                alert("Debe seleccionar ambas fechas.");
                event.preventDefault();
                return;
            }

            if (new Date(fechaInicio) > new Date(fechaFin)) {
                alert("La fecha de inicio debe ser menor que la fecha final.");
                event.preventDefault();
            }
        }

        document.getElementById("btnEnviar").addEventListener("click", validarFechas);


        function calcularFechaFinal() {
                let fechaInicio = document.getElementById("StartDate").value;
                let dias = parseFloat(document.getElementById("cantidadDias").value);

                if (!fechaInicio || isNaN(dias)) return;

                let fechaFinal = new Date(fechaInicio);

                // Sumar días completos
                while (dias >= 1) {
                    fechaFinal.setDate(fechaFinal.getDate() + 1);
                    if (fechaFinal.getDay() !== 0 && fechaFinal.getDay() !== 6) {
                        dias -= 1;
                    }
                }

                // Si queda medio día (menos de 1 día completo), sumar medio día (12 horas)
                if (dias > 0) {
                    fechaFinal.setHours(fechaFinal.getHours() + Math.floor(24 * dias)); // Redondeo hacia abajo
                }

                // Formatear para el input tipo date (solo fecha, sin hora)
                const fechaFormateada = fechaFinal.toISOString().split("T")[0];
                document.getElementById("EndDate").value = fechaFormateada;
        }

    </script>
