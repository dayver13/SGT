@model SIRH.Web.ViewModels.PerfilFuncionarioVM

@{
    ViewBag.Title = "TiempoFuera";
    Layout = "~/Views/Shared/ModuloJefatura.cshtml";
}

<link rel="stylesheet" href="~/Content/sidebar.css">

<style>
    .success {
        padding: 20px;
        background-color: green; /* Red */
        color: white;
        margin-bottom: 15px;
        opacity: 1;
        transition: opacity 0.6s;
        width: 100%;
    }

    .failure {
        padding: 20px;
        background-color: red; /* Red */
        color: white;
        margin-bottom: 15px;
        opacity: 1;
        transition: opacity 0.6s;
        width: 100%;
    }

    /* The close button */
    .closebtn {
        margin-left: 15px;
        color: white;
        font-weight: bold;
        float: right;
        font-size: 22px;
        line-height: 20px;
        cursor: pointer;
        transition: 0.3s;
    }

        /* When moving the mouse over the close button */
        .closebtn:hover {
            color: black;
        }

    .textarea {
        width: 200px;
    }
</style>

@{
    using (Ajax.BeginForm("NuevoRegistro", "ModuloJefatura", new AjaxOptions
    {
        UpdateTargetId = "dvResultadoBusqueda",
        HttpMethod = "POST",
        OnSuccess = "fueExitoso",
        OnFailure = "fuefallido",
        OnBegin = ""
    }))
    {
        <h2>Registrar Tiempo Fuera</h2>
        <div class="jumbotron">
            <div class="sidebar"></div>
            <main>
                <section class="main-content">
                    <div class="user-information">
                        <h2>Seleccione Colaborador</h2>
                        <ul>
                            @Html.DropDownListFor(model => model.personalseleccionado,
                                Model.personal, Model.personalseleccionado,
                                new
                                {
                                    @class = "form-control",
                                    @readonly = "readonly",
                                    @id = "personalseleccionado"
                                })
                        </ul>
                    </div>
                    <div class="form-area">
                        <h2>Datos de Salida</h2>
                        <form action="">
                            <div id="tiempo" class="section">
                                <table class="table table-hover">
                                    <tbody>
                                        <tr>
                                            <th>Fecha Inicio:</th>
                                            <td><input name="StartDate" id="StartDate" type="date" class="form-control" /></td>
                                        </tr>
                                        <tr>
                                            <th>Cantidad de Días:</th>
                                            <td><input name="cantidadDias" id="cantidadDias" type="number" step="0.5" class="form-control" min="0.5" /></td>
                                        </tr>
                                        <tr>
                                            <th>Fecha Final:</th>
                                            <td><input id="EndDate" type="date" class="form-control" readonly /></td>
                                        </tr>
                                        <tr>
                                            <th>Tipo de salida:</th>
                                            @*
                                            <td>
                                               @Html.DropDownListFor(model => model.TiposSalida,
                                               Model.TiposSalida, new
                                               {
                                                   @class = "form-control",
                                                   @id = "salida"
                                               })
                                            </td>
                                            *@
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-2">
                                <button class="btn btn-success " id="btnEnviar" name="SubmitButton" type="submit" value="Registrar Tiempo Fuera">
                                    <i class="fa fa-save"></i>
                                    Registrar Tiempo Fuera
                                </button>
                            </div>
                        </form>
                        <div id="alert">
                        </div>
                    </div>

                </section>
            </main>

            <footer>
                <div>
                    <div class="footer-content"></div>
                </div>
            </footer>
        </div>
    }
}

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")

<script src="~/Scripts/sidebar.js" type="text/javascript"></script>
<script src="~/Scripts/Pages/DetailsFuncionario.js" type="text/javascript"></script>
<script src="~/Scripts/Pages/FormularioSolicitudTeletrabajo.js" type="text/javascript"></script>
<script src="~/scripts/jquery.unobtrusive-ajax.js" type="text/javascript"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>

<script>

    function fueExitoso() {
        var dvalert = document.getElementById("alert");
        var divsucc = document.createElement("div");
        divsucc.className = "success";
        divsucc.innerText = "Envio de solicitud fue exitosa";
        dvalert.appendChild(divsucc);
        setTimeout(function () { document.getElementById("alert").innerHTML = ""; }, 3000);
    }

    function fuefallido() {
        var dvalert = document.getElementById("alert");
        var divsucc = document.createElement("div");
        divsucc.className = "failure";
        divsucc.innerText = "Envio de solicitud fallo, revise que toda la informacin este correcta.";
        dvalert.appendChild(divsucc);
        setTimeout(function () { document.getElementById("alert").innerHTML = ""; }, 3000);
    }

    function validarFechas(event) {
        var fechaInicio = document.getElementById("StartDate").value;
        var fechaFin = document.getElementById("EndDate").value;

        if (!fechaInicio || !fechaFin) {
            alert("Debe seleccionar ambas fechas.");
            event.preventDefault();
            return;
        }

        if (new Date(fechaInicio) >= new Date(fechaFin)) {
            alert("La fecha de inicio debe ser menor que la fecha final.");
            event.preventDefault();
        }
    }

    document.getElementById("btnEnviar").addEventListener("click", validarFechas);

    document.getElementById("cantidadDias").addEventListener("input", function () {
        let fechaInicio = new Date(document.getElementById("StartDate").value);
        let dias = parseFloat(this.value);

        if (!isNaN(fechaInicio.getTime()) && !isNaN(dias)) {
            let fechaFin = calcularFechaFinal(fechaInicio, dias);
            document.getElementById("EndDate").value = fechaFin.toISOString().split("T")[0];
        }
    });

    function calcularFechaFinal(fechaInicio, dias) {
        let fechaFinal = new Date(fechaInicio);
        while (dias > 0) {
            if (dias >= 1) {
                fechaFinal.setDate(fechaFinal.getDate() + 1);
                if (fechaFinal.getDay() !== 5 && fechaFinal.getDay() !== 6) { // Skip Sundays (0) and Saturdays (6)
                    dias -= 1;
                }
            } else {
                break;
            }
        }
        return fechaFinal;
    }

</script>