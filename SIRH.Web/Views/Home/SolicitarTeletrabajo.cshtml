@model SIRH.Web.ViewModels.PerfilFuncionarioVM

@{
    ViewBag.Title = "Solicitud de teletrabajo";
    Layout = "~/Views/Shared/General.cshtml";
}
@{
    if (Session["errorF"] != null && (string)Session["errorF"] == "error")
    {
        <div>
            @{
                Html.RenderPartial("_ErrorFuncionario");
            }
        </div>
    }
    else
    {
        using (Ajax.BeginForm("SolicitarTeletrabajo", "Home", new AjaxOptions
        {
            UpdateTargetId = "dvResultadoBusqueda",
            HttpMethod = "POST",
            OnSuccess = "SuccessCargarFuncionario",
            OnComplete = "CompleteCargarFuncionario",
            OnBegin = "BeginCargarFuncionario"
        }))
        {
            <center><h2>Solicitud de teletrabajo - Personal</h2></center>
            <br />
            <div class="alert alert-info">
                <p class="text-dark">¡Atención! Revise sus datos personales y laborales (primeras tres pestañas) antes de completar el formulario (pestañas en color amarillo). </p>
                <p class="text-dark">En caso de detectar información incorrecta, debe comunicarse con la Dirección de Gestión Institucional de Recursos Humanos para actualizar sus datos. </p>
            </div>
            <div id="tabs">
                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item">
                        <a id="tab1" class="nav-link active" href="#tabs-1" data-toggle="tab" role="tab" aria-controls="tabs-1" aria-selected="true">Datos Generales</a>
                    </li>
                    <li class="nav-item">
                        <a id="tab2" class="nav-link" href="#tabs-2" data-toggle="tab" role="tab" aria-controls="tabs-2" aria-selected="false">Detalle de Puesto</a>
                    </li>
                    <li class="nav-item">
                        <a id="tab3" class="nav-link" href="#tabs-3" data-toggle="tab" role="tab" aria-controls="tabs-3" aria-selected="false">Detalle de Ubicación</a>
                    </li>
                    <li class="nav-item">
                        <a id="tab4" class="nav-link alert-warning" href="#tabs-4" data-toggle="tab" role="tab" aria-controls="tabs-4" aria-selected="false">Formulario solicitud</a>
                    </li>
                    <li class="nav-item">
                        <a id="tab5" class="nav-link alert-warning" href="#tabs-5" data-toggle="tab" role="tab" aria-controls="tabs-5" aria-selected="false">Descripción actividades</a>
                    </li>
                </ul>
                <div class="tab-content" id="myTabContent">
                    <div id="tabs-1" class="tab-pane fade show active" role="tabpanel" aria-labelledby="tab1">
                        <div class="card">
                            <h5 class="card-header">Datos Personales</h5>
                            <div class="card-body">
                                <table class="table table-hover">
                                    <tbody>
                                        <tr>
                                            <th>@Html.LabelFor(model => model.Funcionario.Cedula) </th>
                                            <td>@Html.DisplayFor(model => model.Funcionario.Cedula) </td>
                                            <th>@Html.LabelFor(model => model.Funcionario.Nombre) </th>
                                            <td>@Model.Funcionario.Nombre @Model.Funcionario.PrimerApellido @Model.Funcionario.SegundoApellido </td>
                                            <td>@Html.HiddenFor(model => model.Funcionario.IdEntidad) </td>
                                            <td>@Html.HiddenFor(model => model.Funcionario.Cedula) </td>
                                            <td>@Html.HiddenFor(model => model.Funcionario.Nombre) </td>
                                            <td>@Html.HiddenFor(model => model.Funcionario.PrimerApellido) </td>
                                            <td>@Html.HiddenFor(model => model.Funcionario.SegundoApellido) </td>
                                            <td>@Html.HiddenFor(model => model.Funcionario.FechaNacimiento) </td>
                                            <td>@Html.HiddenFor(model => model.Funcionario.Sexo) </td>
                                        </tr>
                                        <tr>
                                            <th>@Html.LabelFor(model => model.Funcionario.FechaNacimiento) </th>
                                            <td>@Html.DisplayFor(model => model.Funcionario.FechaNacimiento) </td>
                                            <th>@Html.LabelFor(model => model.Funcionario.Sexo) </th>
                                            <td>@Model.Funcionario.Sexo.ToString() </td>
                                        </tr>
                                        <tr>
                                            <th>Edad </th>
                                            <td>@(DateTime.Now.Year - Model.Funcionario.FechaNacimiento.Year)</td>
                                            <th>
                                                @Html.LabelFor(model => model.EstadoCivil.OrderBy(Q => Q.FecFin).LastOrDefault().CatEstadoCivil.DesEstadoCivil)
                                            </th>
                                            @if (Model.EstadoCivil != null)
                                            {
                                                <td>@Html.DisplayFor(model => model.EstadoCivil.OrderBy(Q => Q.FecFin).LastOrDefault().CatEstadoCivil.DesEstadoCivil) </td>
                                            }
                                            else
                                            {
                                                <td>Sin registro</td>
                                            }
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card">
                            <h5 class="card-header">Información de Contacto</h5>
                            <div class="card-body">
                                <table class="table table-hover">
                                    <tbody>
                                        @if (Model.InformacionContacto != null && Model.InformacionContacto.Count() > 0)
                                        {
                                            foreach (var item in Model.InformacionContacto)
                                            {
                                                <tr>
                                                    <th>@Html.Label("Tipo de Contacto")</th>
                                                    <td>@item.TipoContacto.DesTipoContacto </td>
                                                    <th>@Html.Label("Detalle")</th>
                                                    <td>@item.DesContenido </td>
                                                </tr>
                                                <tr>
                                                    <th>@Html.Label("Detalle Adicional")</th>
                                                    <td>@item.DesAdicional </td>
                                                    <th></th>
                                                    <td></td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <th>@Html.Label("Tipo de Contacto")</th>
                                                <td> </td>
                                                <th>@Html.Label("Detalle")</th>
                                                <td> </td>
                                            </tr>
                                            <tr>
                                                <th>@Html.Label("Detalle Adicional")</th>
                                                <td> </td>
                                                <th> </th>
                                                <td> </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card">
                            <h5 class="card-header">Lugar de residencia</h5>
                            <div class="card-body">
                                <table class="table table-hover">
                                    <tbody>
                                        <tr>
                                            <th>@Html.LabelFor(model => model.Direccion.Distrito.Canton.Provincia.NomProvincia) </th>
                                            <td>@Html.DisplayFor(model => model.Direccion.Distrito.Canton.Provincia.NomProvincia) </td>
                                            <th>@Html.LabelFor(model => model.Direccion.Distrito.Canton.NomCanton) </th>
                                            <td>@Html.DisplayFor(model => model.Direccion.Distrito.Canton.NomCanton)</td>
                                        </tr>
                                        <tr>
                                            <th>@Html.LabelFor(model => model.Direccion.Distrito.NomDistrito) </th>
                                            <td>@Html.DisplayFor(model => model.Direccion.Distrito.NomDistrito)</td>
                                            <th>@Html.LabelFor(model => model.Direccion.DirExacta) </th>
                                            <td>@Html.DisplayFor(model => model.Direccion.DirExacta)</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>

                    <div id="tabs-2" class="tab-pane fade" role="tabpanel" aria-labelledby="tab2">

                        <div class="card">
                            <h5 class="card-header">Detalle Nombramiento</h5>
                            <div class="card-body">
                                <table class="table table-hover">
                                    <tbody>
                                        <tr>
                                            <th>@Html.LabelFor(model => model.DetalleContrato.FechaIngreso) </th>
                                            <td>@Html.DisplayFor(model => model.DetalleContrato.FechaIngreso)</td>
                                            <th>
                                                Última evaluación de desempeño
                                            </th>
                                            <td>@Html.DisplayFor(model => model.Calificaciones.OrderBy(Q => Q.Periodo.IdEntidad).LastOrDefault().CalificacionDTO.DesCalificacion)</td>
                                        </tr>
                                        <tr>
                                            <th>@Html.LabelFor(model => model.Puesto.CodPuesto) </th>
                                            <td>@Html.DisplayFor(model => model.Puesto.CodPuesto)</td>
                                            <th>@Html.LabelFor(model => model.Puesto.EstadoPuesto.DesEstadoPuesto)</th>
                                            <td>@Html.DisplayFor(model => model.Puesto.EstadoPuesto.DesEstadoPuesto)</td>
                                        </tr>
                                        <tr>
                                            <th>@Html.LabelFor(model => model.DetallePuesto.Clase.DesClase) </th>
                                            <td>@Html.DisplayFor(model => model.DetallePuesto.Clase.DesClase)</td>
                                            <th>@Html.LabelFor(model => model.DetallePuesto.Especialidad.DesEspecialidad)</th>
                                            <td>@Html.DisplayFor(model => model.DetallePuesto.Especialidad.DesEspecialidad)</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div id="tabs-3" class="tab-pane fade" role="tabpanel" aria-labelledby="tab3">
                        <div class="card">
                            <h5 class="card-header">Ubicación Administrativa</h5>
                            <div class="card-body">
                                <table class="table table-hover">
                                    <tr>
                                        <th>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision) </th>
                                        <td>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision)</td>
                                        <th>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion)</th>
                                        <td>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion)</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento) </th>
                                        <td>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento)</td>
                                        <th>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion)</th>
                                        <td>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion)</td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="card">
                            <h5 class="card-header">Ubicación Trabajo</h5>
                            <div class="card-body">
                                <table class="table table-hover">
                                    <tbody>
                                        <tr>
                                            <th>@Html.LabelFor(model => model.UbicacionTrabajo.Distrito.Canton.Provincia.NomProvincia) </th>
                                            <td>@Html.DisplayFor(model => model.UbicacionTrabajo.Distrito.Canton.Provincia.NomProvincia)</td>
                                            <th>@Html.LabelFor(model => model.UbicacionTrabajo.Distrito.Canton.NomCanton)</th>
                                            <td>@Html.DisplayFor(model => model.UbicacionTrabajo.Distrito.Canton.NomCanton)</td>
                                        </tr>
                                        <tr>
                                            <th>@Html.LabelFor(model => model.UbicacionTrabajo.Distrito.NomDistrito) </th>
                                            <td>@Html.DisplayFor(model => model.UbicacionTrabajo.Distrito.NomDistrito)</td>
                                            <th>@Html.LabelFor(model => model.UbicacionTrabajo.ObsUbicacionPuesto)</th>
                                            <td>@Html.DisplayFor(model => model.UbicacionTrabajo.ObsUbicacionPuesto)</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div id="tabs-4" class="tab-pane fade" role="tabpanel" aria-labelledby="tab4">
                        <div class="card">
                            <h5 class="card-header">Formulario</h5>
                            <div class="card-body">
                                <table class="table table-hover">
                                    <tr>
                                        <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.Escolaridad) </th>
                                        <td>
                                            @Html.DropDownListFor(model => model.EscolaridadSeleccionada,
                                                                            Model.ListaEscolaridad, "Seleccione...",
                                                                            new
                                                                            {
                                                                                @class = "form-control",
                                                                                @readonly = "readonly"
                                                                            })
                                        </td>
                                        <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.CantidadPersonasDireccionPrimaria)</th>
                                        <td>@Html.TextBoxFor(model => model.SolicitudTeletrabajo.CantidadPersonasDireccionPrimaria, new { @type = "number" })</td>
                                    </tr>
                                    <tr>
                                        <th>¿Desea agregar un lugar de Teletrabajo Secundario?</th>
                                        <td>
                                            @Html.RadioButtonFor(model => model.SolicitudTeletrabajo.Teletrabajable, true, new { onclick = "toggleTextBox()" }) <label style="margin-right: 10px;">Sí</label>
                                            @Html.RadioButtonFor(model => model.SolicitudTeletrabajo.Teletrabajable, false, new { @id = "secundarioNo", @checked = "checked", onclick = "toggleTextBox()" }) <label>No</label>
                                        </td>
                                        <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.CantidadPersonasDireccionSecundaria)</th>
                                        <td>@Html.TextBoxFor(model => model.SolicitudTeletrabajo.CantidadPersonasDireccionSecundaria, new { @id = "personasSecundario", @type = "number" })</td>
                                    </tr>
                                    <tr>
                                        <th>Provincia de Lugar de Teletrabajo Secundario</th>
                                        <td>
                                            @Html.DropDownListFor(model => model.ProvinciaSeleccionada,
                                                                    Model.ListaProvincia, "Seleccione...",
                                                                    new
                                                                    {
                                                                        @class = "form-control",
                                                                        @readonly = "readonly",
                                                                        @id = "provinciaSecundario",
                                                                        @onchange = "ObtenerCantones(this.value)"
                                                                    })
                                        </td>
                                        <th>Cantón de Lugar de Teletrabajo Secundario</th>
                                        <td>
                                            @Html.DropDownListFor(model => model.CantonSeleccionado,
                                                                            Model.ListaCantones, "Seleccione...",
                                                                            new
                                                                            {
                                                                                @class = "form-control",
                                                                                @readonly = "readonly",
                                                                                @id = "cantonSecundario",
                                                                                @onchange = "ObtenerDistritos(this.value)"
                                                                            })
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Distrito de Lugar de Teletrabajo Secundario</th>
                                        <td>
                                            @Html.DropDownListFor(model => model.DistritoSeleccionado,
                                                                            Model.ListaDistritos, "Seleccione...",
                                                                            new
                                                                            {
                                                                                @class = "form-control",
                                                                                @readonly = "readonly",
                                                                                @id = "distritoSecundario"
                                                                            })
                                        </td>
                                        <th>Dirección exacta de lugar de Teletrabajo Secundario</th>
                                        <td>@Html.TextAreaFor(model => model.SolicitudTeletrabajo.DireccionExactaSecundaria, new { style = "width: 100%;", rows = "5", @id = "senasSecundario" })</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.TiempoLaborarDependencia) </th>
                                        <td>@Html.TextBoxFor(model => model.SolicitudTeletrabajo.TiempoLaborarDependencia, new { @type = "number" })</td>
                                        <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.TiempoLaborarMOPT)</th>
                                        <td>@Html.TextBoxFor(model => model.SolicitudTeletrabajo.TiempoLaborarMOPT, new { @type = "number" })</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.Teletrabajable) </th>
                                        <td>
                                            @Html.RadioButtonFor(model => model.SolicitudTeletrabajo.Teletrabajable, true) <label style="margin-right: 10px;">Sí</label>
                                            @Html.RadioButtonFor(model => model.SolicitudTeletrabajo.Teletrabajable, false) <label>No</label>
                                        </td>
                                        <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.CantidadDiasTeletrabajo)</th>
                                        <td>@Html.TextBoxFor(model => model.SolicitudTeletrabajo.CantidadDiasTeletrabajo, new { @type = "number", @min = "1", @max = "4", @id = "cantDias", @onchange = "updateMaxCheckboxes()" })</td>
                                    </tr>
                                    <tr>
                                        <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.DetalleDiasTeletrabajo) </th>
                                        <td>
                                            <input type="checkbox" id="lunes" name="dias" value="Lunes" class="limited-dias" onclick="limitCheckboxes()">
                                            <label for="lunes">Lunes</label><br>
                                            <input type="checkbox" id="martes" name="dias" value="Martes" class="limited-dias" onclick="limitCheckboxes()">
                                            <label for="martes">Martes</label><br>
                                            <input type="checkbox" id="miercoles" name="dias" value="Miércoles" class="limited-dias" onclick="limitCheckboxes()">
                                            <label for="miercoles">Miércoles</label><br>
                                            <input type="checkbox" id="jueves" name="dias" value="Jueves" class="limited-dias" onclick="limitCheckboxes()">
                                            <label for="jueves">Jueves</label><br>
                                            <input type="checkbox" id="viernes" name="dias" value="Viernes" class="limited-dias" onclick="limitCheckboxes()">
                                            <label for="viernes">Viernes</label><br>
                                        </td>
                                        <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.Horario)</th>
                                        <td>@Html.TextBoxFor(model => model.SolicitudTeletrabajo.Horario)</td>
                                    </tr>
                                    @*<tr>
                                            <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.Sistemas) </th>
                                            <td colspan="3">
                                                <button class="btn btn-info" id="DialogEstCivil" style="vertical-align:middle;">
                                                    <i class="fa fa-pie-chart"> Seleccionar sistemas</i>
                                                </button>
                                            </td>
                                        </tr>*@
                                    @*<tr>
                                            <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.Funciones) </th>
                                            <td colspan="3">@Html.TextAreaFor(model => model.SolicitudTeletrabajo.Funciones, new { style = "width: 100%;", rows = "5" })</td>
                                        </tr>*@
                                    @*<tr>
                                            <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.TiempoFunciones) </th>
                                            <td>@Html.TextBoxFor(model => model.SolicitudTeletrabajo.TiempoFunciones, new { @type = "number" })</td>
                                            <th></th>
                                            <td></td>
                                        </tr>*@
                                    <tr>
                                        <th>@Html.LabelFor(model => model.SolicitudTeletrabajo.Razones)</th>
                                        <td colspan="3">@Html.TextAreaFor(model => model.SolicitudTeletrabajo.Razones, new { style = "width: 100%;", rows = "5" })</td>
                                    </tr>
                                    <tr>
                                        <td colspan="4"><div class="alert alert-info">Para guardar la información debe agregar la descripción de sus actividades (siguiente pestaña).</div></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div id="tabs-5" class="tab-pane fade" role="tabpanel" aria-labelledby="tab2">

                        <div class="card">
                            <h5 class="card-header">Actividades</h5>
                            <div class="alert alert-info">Cada vez que agregue una actividad, deberá verificar si esta es teletrabajable utilizando el botón "¿Es teletrabajable?"</div>
                            <div class="card-body">
                                <div id="registros">
                                </div>
                                <center>
                                    <button type="button" id="AgregarCompetencia" class="btn btn-outline-info" onclick="FuncionAgregarCompetencia();"><i class="fa fa-plus-circle"></i> Agregar Actividad</button>
                                </center>
                            </div>
                        </div>
                        <br />
                        @*<div style="text-align: right;">
                            <button type="submit" class="btn btn-success">Enviar solicitud</button>
                        </div>*@
                        <div class="col-2">
                            <button class="btn btn-success " id="btnEnviar" name="SubmitButton" type="submit" value="Enviar solicitud">
                                <i class="fa fa-save"></i>
                                Enviar solicitud
                            </button>
                        </div>
                        <div class="row">
                            <div class="col-10">
                                <center>
                                    <div id="preloader" class="loader" hidden></div>
                                </center>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }

        <!-- Modal -->
        <div class="modal fade" id="calificaciones" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalCenterTitle">Historial de Calificaciones</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="card">
                            <h5 class="card-header">Historial de Calificaciones</h5>
                            <div class="card-body">

                                <table class="table table-hover">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Periodo</th>
                                            <th>Calificación</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Calificaciones)
                                        {
                                            <tr>
                                                <td>@item.Periodo.IdEntidad.ToString()</td>
                                                <td>@item.CalificacionDTO.DesCalificacion.ToString()</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="estadoCivil" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalCenterTitle">Seleccione los sistemas que usted requiere utilizar para realizar su trabajo en condiciones normales</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="card">
                            <h5 class="card-header">Detalle sistemas</h5>
                            <div class="card-body">
                                <input type="checkbox" id="vacaciones" name="sistemas" value="Módulo de Información de Vacaciones (CITEC)">
                                <label for="vacaciones">Módulo de Información de Vacaciones (CITEC)</label><br>

                                <input type="checkbox" id="servicios_institucionales" name="sistemas" value="Plataforma de Servicios Institucional (SICI)">
                                <label for="servicios_institucionales">Plataforma de Servicios Institucional (SICI)</label><br>

                                <input type="checkbox" id="bienes_inmuebles" name="sistemas" value="Sistema de Administración de Bienes Inmuebles (SICOVI)">
                                <label for="bienes_inmuebles">Sistema de Administración de Bienes Inmuebles (SICOVI)</label><br>

                                <input type="checkbox" id="administracion_inventarios" name="sistemas" value="Sistema de Administración de Inventarios (DAI)">
                                <label for="administracion_inventarios">Sistema de Administración de Inventarios (DAI)</label><br>

                                <input type="checkbox" id="equipo_maquinaria" name="sistemas" value="Sistema de Administración de Equipo y Maquinaría (SAEM)">
                                <label for="equipo_maquinaria">Sistema de Administración de Equipo y Maquinaría (SAEM)</label><br>

