<script>
    function toggleTextBox() {
        var option1 = document.getElementById("secundarioNo");
        var textBox = document.getElementById("senasSecundario");
        var prov = document.getElementById("provinciaSecundario");
        var cant = document.getElementById("cantonSecundario");
        var dist = document.getElementById("distritoSecundario");
        var personas = document.getElementById("personasSecundario");
        if (option1.checked) {
            textBox.disabled = true;
            prov.disabled = true;
            cant.disabled = true;
            dist.disabled = true;
            personas.disabled = true;
        } else {
            textBox.disabled = false;
            prov.disabled = false;
            cant.disabled = false;
            dist.disabled = false;
            personas.disabled = false;
        }
    }

    function updateMaxCheckboxes() {
        limitCheckboxes(); // Ensure the limit is enforced when the max value changes
    }

    function limitCheckboxes() {
        const maxCheckboxes = document.getElementById('cantDias').value;
        const checkboxes = document.querySelectorAll('.limited-dias');
        let checkedCount = 0;

        checkboxes.forEach(checkbox => {
            if (checkbox.checked) {
                checkedCount++;
            }
        });

        if (checkedCount >= maxCheckboxes) {
            checkboxes.forEach(checkbox => {
                if (!checkbox.checked) {
                    checkbox.disabled = true;
                }
            });
        } else {
            checkboxes.forEach(checkbox => {
                checkbox.disabled = false;
            });
        }
    }


    // Ensure the correct state on page load
    document.addEventListener("DOMContentLoaded", function () {
        toggleTextBox();
    });
</script>

