<script>
    function checkSelection(identificador) {
        var select1 = document.getElementById('medios' + identificador).value;
        var select2 = document.getElementById('medible' + identificador).value;
        var select3 = document.getElementById('supervision' + identificador).value;
        var textDiv = document.getElementById('teletrabajable' + identificador);

        if (select1 === 'Sí' && select2 === 'Sí' && select3 === 'Sí') {
            textDiv.innerText = 'Sí';
        } else {
            textDiv.innerText = 'No';
        }
    }
</script>

<script type="text/javascript">
    function ObtenerCantones(idProvincia) {
        $list = $("#cantonSecundario");

        $.ajax({
            type: "post",
            url: "/Home/GetCantones",
            data: { idProvincia: idProvincia },
            datatype: "json",
            traditional: true,
            success: function (data) {
                if (data.success) {
                    $list.empty();
                    for (var i = 0; i < data.listado.length; i++) {
                        $list.append('<option value="' + data.listado[i].IdEntidad + '"> ' + data.listado[i].NomCanton + ' </option>');
                    }
                    ObtenerDistritos(data.listado[0].IdEntidad);
                }
                else {
                    alert(data.mensaje);
                }
            },
            error: function (err) {
                alert("Error");
            }
        });
    }

    function ObtenerDistritos(idCanton) {
        $list = $("#distritoSecundario");

        $.ajax({
            type: "post",
            url: "/Home/GetDistritos",
            data: { idCanton: idCanton },
            datatype: "json",
            traditional: true,
            success: function (data) {
                if (data.success) {
                    $list.empty();
                    for (var i = 0; i < data.listado.length; i++) {
                        $list.append('<option value="' + data.listado[i].IdEntidad + '"> ' + data.listado[i].NomDistrito + ' </option>');
                    }
                }
                else {
                    alert(data.mensaje);
                }
            },
            error: function (err) {
                alert("Error");
            }
        });
    }
</script>