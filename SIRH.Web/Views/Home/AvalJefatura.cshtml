<script>
    function verificaAprueba() {
        var select1 = document.getElementById('apruebaSi');
        var textDiv = document.getElementById('tablaJustificacion');
        var otraTabla = document.getElementById('tablaAprobacion');

        if (select1.checked) {
            textDiv.style.display = 'none';
            otraTabla.style.display = 'table';
        } else {
            textDiv.style.display = 'table';
            otraTabla.style.display = 'none';
        }
    }

    function verificaTeletrabajable() {
        var select1 = document.getElementById('teletrabajableSi');
        var select2 = document.getElementById('teletrabajableNo');
        var textDiv = document.getElementById('tablaJustificacionTeletrabajable');
        var otraTabla = document.getElementById('tablaAprobacionTeletrabajable');

        if (select1.checked) {
            otraTabla.style.display = 'table';
        } else {
            otraTabla.style.display = 'none';
        }

        if (select2.checked) {
            textDiv.style.display = 'table';
        } else {
            textDiv.style.display = 'none';
        }
    }

    function verificaCaracteristicas() {
        var select1 = document.getElementById('caracteristicasSi');
        var select2 = document.getElementById('CaracteristicasNo');
        var textDiv = document.getElementById('trJustificacionCaracteristicas');

        if (select1.checked) {
            textDiv.style.display = 'table-row';
        } else {
            textDiv.style.display = 'none';
        }
    }

    function verificaTeletrabajo() {
        var select1 = document.getElementById('teletrabajoNo');
        var select2 = document.getElementById('teletrabajoSi');
        var textDiv = document.getElementById('trJustificacionTeletrabajo');

        if (select1.checked) {
            textDiv.style.display = 'table-row';
        } else {
            textDiv.style.display = 'none';
        }
    }

    // Ensure the correct state on page load
    document.addEventListener("DOMContentLoaded", function () {
        verificaAprueba();
        verificaTeletrabajable();
        verificaCaracteristicas();
        verificaTeletrabajo();
    });
</script>

