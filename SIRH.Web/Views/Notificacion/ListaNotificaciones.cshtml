@model IEnumerable<SIRH.DTO.CNotificacionUsuarioDTO>

@{
    ViewBag.Title = "Notificaciones";
    Layout = "~/Views/Shared/Teletrabajo.cshtml";
}

<style>
    .notification-wrapper {
        max-width: 800px;
        margin: auto;
        padding: 20px;
    }

    .notification-box {
        border-radius: 12px;
        background-color: #ffffff;
        padding: 20px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        margin-bottom: 20px;
        transition: transform 0.2s;
    }

        .notification-box.unread {
            background-color: #e9f2ff;
            border-left: 5px solid #0056b3;
        }

        .notification-box:hover {
            transform: scale(1.01);
        }

    .notification-header {
        font-weight: 600;
        font-size: 18px;
        color: #333;
    }

    .notification-date {
        font-size: 13px;
        color: #888;
        margin-bottom: 8px;
    }

    .notification-body {
        font-size: 15px;
        color: #444;
    }

    .notification-actions {
        margin-top: 30px;
        display: flex;
        gap: 10px;
    }

    .btn-custom {
        padding: 10px 20px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-weight: bold;
        transition: background-color 0.2s;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    .btn-danger {
        background-color: #dc3545;
        color: white;
    }

        .btn-danger:hover {
            background-color: #a71d2a;
        }

    .checkbox {
        margin-right: 10px;
    }

    .message-box {
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 6px;
    }

    .message-success {
        background-color: #d4edda;
        border-left: 5px solid #28a745;
        color: #155724;
    }

    .message-error {
        background-color: #f8d7da;
        border-left: 5px solid #dc3545;
        color: #721c24;
    }
</style>

<div class="notification-wrapper">
    <h2>📬 Notificaciones</h2>

    @if (ViewBag.UnreadCount > 0)
    {
        <p style="font-weight: bold; color: #0056b3; margin-bottom: 20px;">
            🔔 Tienes @ViewBag.UnreadCount notificación@(ViewBag.UnreadCount == 1 ? "" : "es") sin leer
        </p>
    }

    @if (ViewBag.Success != null)
    {
        <div class="message-box message-success">
            ✅ @ViewBag.Success
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="message-box message-error">
            ⚠ @ViewBag.Error
        </div>
    }

    @if (!Model.Any())
    {
        <p>No hay notificaciones disponibles.</p>
    }
    else
    {
        <form method="post" action="@Url.Action("AccionesNotificaciones", "Notificacion")">
            @foreach (var item in Model)
            {
                var boxClass = item.Leido ? "notification-box" : "notification-box unread";

                <div class="@boxClass">
                    <label>
                        <input type="checkbox" name="selectedIds" class="checkbox" value="@item.Id" />
                        <span class="notification-header">@item.Asunto</span>
                    </label>
                    <div class="notification-date">@item.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="notification-body">@item.Contenido</div>
                </div>
            }

            <div class="notification-actions">
                <button type="submit" name="actionType" value="markRead" class="btn-custom btn-primary">✔ Marcar como leída</button>
                <button type="submit" name="actionType" value="delete" class="btn-custom btn-danger">🗑 Eliminar</button>
            </div>
        </form>
    }
</div>
