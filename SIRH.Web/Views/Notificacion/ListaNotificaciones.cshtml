@model IEnumerable<SIRH.DTO.CNotificacionUsuarioDTO>

@{
    ViewBag.Title = "Notificaciones";
    Layout = "~/Views/Shared/Teletrabajo.cshtml";
}

<link rel="stylesheet" href="~/Content/sidebar.css">

<style>
    .notification-box {
        border: 2px solid #007bff;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
        background-color: #f9f9f9;
    }

    .notification {
        border: 1px solid #ccc;
        padding: 15px;
        margin-bottom: 10px;
        border-radius: 5px;
    }

    .notification-header {
        font-weight: bold;
    }

    .notification-date {
        font-size: small;
        color: gray;
    }
</style>

<div class="container">
    <div class="notification-box">
        <h2>Lista de Notificaciones</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <strong>Error:</strong> @ViewBag.Error
            </div>
        }
        else if (!Model.Any())
        {
            <p>No hay notificaciones disponibles.</p>
        }
        else
        {
            foreach (var item in Model)
            {
                <div class="notification">
                    <div class="notification-header">@item.Asunto</div>
                    <div class="notification-date">@item.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="notification-body">@item.Contenido</div>
                </div>
            }
        }
    </div>
</div>
