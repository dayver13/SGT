    function abrirActualizarNivel(idCompetencia, tipoCompetencia) {
        $("#modal-actualizar").appendTo("body");
        $('#modal-actualizar').modal('show');
        $("#modal-actualizar #titulo").html(tipoCompetencia == 1 ? "Compromiso con el servicio público," : "Integridad en el desempeño de la función pública,");
        $("#modal-actualizar #competencia").val(idCompetencia);
        return true;
    }

    function CompleteActualizarNivelCompetencia(btnId, loaderId) {
        $("#" + btnId).show();
        $("#" + loaderId).hide();
    }

    function ActualizarNivelCompetenciaConfirmado() {
        if ($('#modal-actualizar #nivel').find(":selected").text() == "Seleccione...") {
            $("#modal-actualizar #error").show();
            $("#modal-actualizar #error").text("Debe selecionar el nivel correspondinete.");
            return false;
        }

        $("#modal-actualizar #error").hide();
        return true;
    }

    function abrirAgregarComportamientoTransversal(idCompetencia, tipoCompetencia) {
        $("#modal-agregar-comportamiento").appendTo("body");
        $('#modal-agregar-comportamiento').modal('show');
        $("#modal-agregar-comportamiento #titulo").html(tipoCompetencia == 1 ? "Compromiso con el servicio público," : "Integridad en el desempeño de la función pública,");
