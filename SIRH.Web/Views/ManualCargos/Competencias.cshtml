@model SIRH.Web.ViewModels.ManualCargosVM

@{
    ViewBag.Title = "Competencias";
    Layout = "~/Views/Shared/ManualCargos.cshtml";
}


@using (Ajax.BeginForm("Competencias", "ManualCargos", new AjaxOptions
{
    UpdateTargetId = "dvResultadoBusqueda",
    HttpMethod = "POST",
    OnComplete = "CompleteSearch",
    OnBegin = "BeginSearch"
}))
{
    <div class="jumbotron">
        <center>
            <h1>Competencias transversales y evidencias</h1>
            <h4>Cargo: @Model.Cargo.NombreCargo</h4>
            @Html.HiddenFor(model => model.Cargo.IdEntidad)
            @if (Model.CompetenciasTransversales != null && Model.CompetenciasTransversales.Count > 0)
            {
                <br />
                <div class="card">
                    <div class="card-header text-left">
                        <strong>Transversales</strong>
                        @Html.HiddenFor(model => model.Cargo.Mensaje)
                    </div>
                    <div class="card-body">
                        @for (int i = 0; i < Model.CompetenciasTransversales.Count; i++)
                        {
                            <table class="table table-hover">
                                <thead>
                                    <tr class="card-header">
                                        <td><b>Competencia: @(Model.CompetenciasTransversales[i].TipoCompetencia == 1 ? "Compromiso con el servicio público" : "Integridad en el desempeño de la función pública")</b></td>
                                        <td>Nivel de dominio: @(Model.CompetenciasTransversales[i].NivelDominio == 1 ? "Basico" : Model.CompetenciasTransversales[i].NivelDominio == 2 ? "Intermedio" : Model.CompetenciasTransversales[i].NivelDominio == 3 ? "Avanzado" : "Destacado")</td>
                                        <td><button type="button" class="btn btn-outline-success" title="Permite modificar el nivel de dominio" onclick="abrirActualizarNivel(@(Model.CompetenciasTransversales[i].IdEntidad), '@(Model.CompetenciasTransversales[i].TipoCompetencia)');"><i class="fa fa-pencil"></i> Modificar nivel de dominio</button></td>
                                        <td><button type="button" class="btn btn-outline-info" title="Permite agregar comportamientos" onclick="abrirAgregarComportamientoTransversal(@(Model.CompetenciasTransversales[i].IdEntidad), '@(Model.CompetenciasTransversales[i].TipoCompetencia)');"><i class="fa fa-plus-circle"></i> Agregar comportamiento</button></td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="4">
                                            <table class="table table-hover">
                                                @for (int j = 0; j < Model.CompetenciasTransversales[i].ComportamientosTransversales.Count; j++)
                                                {
                                                    <tr>
                                                        <td><b>Comportamiento N° @(j + 1)</b></td>
                                                        <td>@Model.CompetenciasTransversales[i].ComportamientosTransversales[j].ComportamientoTransversal</td>
                                                        <td><button type="button" class="btn btn-outline-dark" title="Permite agregar evidencias" onclick="abrirAgregarEvidenciaTransversal(@(Model.CompetenciasTransversales[i].ComportamientosTransversales[j].IdEntidad), '@(Model.CompetenciasTransversales[i].TipoCompetencia)', @(j+1));"><i class="fa fa-plus-circle"></i> Agregar evidencia</button></td>
                                                        <td><button type="button" class="btn btn-outline-danger" title="Permite eliminar comportamientos" onclick="abrirEliminarTransversal(@(Model.CompetenciasTransversales[i].ComportamientosTransversales[j].IdEntidad), 'comportamiento', @(j+1))"><i class="fa fa-trash"></i> Eliminar comportamiento</button></td>
                                                    </tr>
                                                    <tr>
                                                        <td colspan="4">
                                                            <table class="table table-hover">
                                                                @for (int k = 0; k < Model.CompetenciasTransversales[i].ComportamientosTransversales[j].EvidenciasComportamientoTransversal.Count; k++)
                                                                {
                                                                    <tr>
                                                                        <td><b>Evidencia N° @(k + 1)</b></td>
                                                                        <td>@Model.CompetenciasTransversales[i].ComportamientosTransversales[j].EvidenciasComportamientoTransversal[k].Evidencia</td>
                                                                        <td><button type="button" class="btn btn-outline-secondary" title="Permite eliminar evidencias" onclick="abrirEliminarTransversal(@(Model.CompetenciasTransversales[i].ComportamientosTransversales[j].EvidenciasComportamientoTransversal[k].IdEntidad), 'evidencia', @(k+1))"><i class="fa fa-trash"></i> Eliminar evidencia</button></td>
                                                                    </tr>
                                                                }
                                                            </table>
                                                        </td>
                                                    </tr>
                                                }
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            }
            else
            {
            <div class="card">
                <div class="card-header text-left">
                    <strong>Transversales</strong>
                </div>
                <div class="card-body">
                    <div id="registros">
                        <div class="card">
                            <div class="card-header text-left">
                                <strong>Competencia N° 1: Compromiso con el servicio público</strong>
                            </div>
                            <div class="card-body">
                                <div class="form-group row">
                                    <div class="col-sm-3">
                                        Nivel de dominio
                                    </div>
                                    <div class="col-sm-9">
                                        <select id="nivel" name="nivel1" class="form-control">
                                            <option value="vacio">Seleccione...</option>
                                            <option value="basico">Básico</option>
                                            <option value="intermedio">Intermedio</option>
                                            <option value="avanzado">Avanzado</option>
                                            <option value="destacado">Destacado</option>
                                        </select>
                                    </div>
                                </div>
                                <div id="comportamientos"></div>
                                <button type="button" id="AgregarComportamiento" class="btn btn-outline-info" onclick="FuncionAgregarComportamiento();"><i class="fa fa-plus-circle"></i> Agregar Comportamiento</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="registros">
                        <div class="card">
                            <div class="card-header text-left">
                                <strong>Competencia N° 2: Integridad en el desempeño de la función pública</strong>
                            </div>
                            <div class="card-body">
                                <div class="form-group row">
                                    <div class="col-sm-3">
                                        Nivel de dominio
                                    </div>
                                    <div class="col-sm-9">
                                        <select id="nivel" name="nivel2" class="form-control">
                                            <option value="vacio">Seleccione...</option>
                                            <option value="basico">Básico</option>
                                            <option value="intermedio">Intermedio</option>
                                            <option value="avanzado">Avanzado</option>
                                            <option value="destacado">Destacado</option>
                                        </select>
                                    </div>
                                </div>
                                <div id="comportamientos1"></div>
                                <button type="button" id="AgregarActividadCompromiso1" class="btn btn-outline-info" onclick="FuncionAgregarComportamiento1();"><i class="fa fa-plus-circle"></i> Agregar Comportamiento</button>
                            </div>
                        </div>
                    </div>
                    <br />
                </div>
            </div>
            }

        </center>
        <br />
        <div class="float-right">
            <a href="@Url.Action("Requerimientos", "ManualCargos", new { codigo = Model.Cargo.IdEntidad })" class="btn btn-outline-danger">
                <i class="fa fa-arrow-circle-o-left"></i> Regresar
            </a>
            <button type="submit" class="btn btn-success"><i class="fa fa-floppy-o"></i> Guardar y continuar</button>
        </div>
    </div>
}

<div id="dvResultadoBusqueda"></div>
<br />

<!--MODAL ACTUALIZAR-->
<div class="modal fade" id="modal-actualizar" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header alert alert-dark" role="alert">
                <h5 class="modal-title" id="exampleModalCenterTitle">
                    <i class="fa fa-exclamation-circle d-inline" style="font-size:25px;"></i>
                    ¡Atención! Usted está apunto de actualizar el nivel de la competencia: <span id="titulo"></span> del cargo @Model.Cargo.NombreCargo
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Ajax.BeginForm("ActualizarNivelCompetencia", "ManualCargos", new AjaxOptions
            {
                HttpMethod = "Post",
                UpdateTargetId = "dvActualizarNivelCompetencia",
                OnSuccess = "ActualizarNivelCompetencia",
                OnBegin = "ActualizarNivelCompetenciaConfirmado",
                OnFailure = "CompleteActualizarNivelCompetencia('btnAgregar','preloader')",
                OnComplete = "CompleteActualizarNivelCompetencia('btnAgregar','preloader')"
            }, new { @id = "formActualizarNivelCompetencia" }))
            {
                <div class="modal-body">
                    <input type="hidden" id="competencia" name="competencia" />
                    <strong>Seleccione el nivel de dominio para esta competencia.</strong>
                    <select class="form-control" id="nivel" name="nivel">
                        <option>Seleccione...</option>
                        <option>Básico</option>
                        <option>Intermedio</option>
                        <option>Avanzado</option>
                        <option>Destacado</option>
                    </select>
                    <div id="error" class="alert alert-danger" style="display:none"></div>
                    <div id="dvActualizarNivelCompetencia"></div>
                    @Html.HiddenFor(model => model.Cargo.IdEntidad, new { @id = "cargo" })
                </div>
                <div class="modal-footer">
                    <input name="SubmitButton" class="btn btn-primary" type="submit" value="Modificar nivel" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>

<!--MODAL AGREGAR COMPORTAMIENTO-->
<div class="modal fade" id="modal-agregar-comportamiento" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header alert alert-dark" role="alert">
                <h5 class="modal-title" id="exampleModalCenterTitle">
                    <i class="fa fa-exclamation-circle d-inline" style="font-size:25px;"></i>
                    ¡Atención! Usted está apunto de agregar un nuevo comportamiento para la competencia: <span id="titulo"></span> del cargo @Model.Cargo.NombreCargo
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Ajax.BeginForm("AgregarComportamientoTransversal", "ManualCargos", new AjaxOptions
            {
                HttpMethod = "Post",
                UpdateTargetId = "dvAgregarComportamientoTransversal",
                OnSuccess = "AgregarComportamientoTransversal",
                OnBegin = "AgregarComportamientoTransversalConfirmado",
                OnFailure = "CompleteAgregarComportamientoTransversal('btnAgregar','preloader')",
                OnComplete = "CompleteAgregarComportamientoTransversal('btnAgregar','preloader')"
            }, new { @id = "formAgregarComportamientoTransversal" }))
            {
                <div class="modal-body">
                    <input type="hidden" id="competencia" name="competencia" />
                    <strong>Digite el comportamiento a agregar.</strong>
                    <textarea id="comportamiento" name="comportamiento" class="form-control"></textarea>
                    <div id="error" class="alert alert-danger" style="display:none"></div>
                    <div id="dvAgregarComportamientoTransversal"></div>
                    @Html.HiddenFor(model => model.Cargo.IdEntidad, new { @id = "cargo" })
                </div>
                <div class="modal-footer">
                    <input name="SubmitButton" class="btn btn-primary" type="submit" value="Agregar comportamiento" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>

<!--MODAL AGREGAR EVIDENCIA-->
<div class="modal fade" id="modal-agregar-evidencia" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header alert alert-dark" role="alert">
                <h5 class="modal-title" id="exampleModalCenterTitle">
                    <i class="fa fa-exclamation-circle d-inline" style="font-size:25px;"></i>
                    ¡Atención! Usted está apunto de agregar una nueva evidencia para el comportamiento: <span id="titulo"></span> del cargo @Model.Cargo.NombreCargo
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Ajax.BeginForm("AgregarEvidenciaTransversal", "ManualCargos", new AjaxOptions
            {
                HttpMethod = "Post",
                UpdateTargetId = "dvAgregarEvidenciaTransversal",
                OnSuccess = "AgregarEvidenciaTransversal",
                OnBegin = "AgregarEvidenciaTransversalConfirmado",
                OnFailure = "CompleteAgregarEvidenciaTransversal('btnAgregar','preloader')",
                OnComplete = "CompleteAgregarEvidenciaTransversal('btnAgregar','preloader')"
            }, new { @id = "formAgregarEvidenciaTransversal" }))
            {
                <div class="modal-body">
                    <input type="hidden" id="comportamiento" name="comportamiento" />
                    <strong>Digite la evidencia a agregar.</strong>
                    <textarea id="evidencia" name="evidencia" class="form-control"></textarea>
                    <div id="error" class="alert alert-danger" style="display:none"></div>
                    <div id="dvAgregarEvidenciaTransversal"></div>
                    @Html.HiddenFor(model => model.Cargo.IdEntidad, new { @id = "cargo" })
                </div>
                <div class="modal-footer">
                    <input name="SubmitButton" class="btn btn-primary" type="submit" value="Agregar evidencia" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>

<!--MODAL ELIMINAR-->
<div class="modal fade" id="modal-eliminar" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header alert alert-danger" role="alert">
                <h5 class="modal-title" id="exampleModalCenterTitle">
                    <i class="fa fa-exclamation-circle d-inline" style="font-size:25px;"></i>
                    ¡Atención! Usted está apunto de eliminar <span id="titulo"></span>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Ajax.BeginForm("EliminarTransversal", "ManualCargos", new AjaxOptions
            {
                HttpMethod = "Post",
                UpdateTargetId = "dvEliminarTransversal",
                OnBegin = "EliminarTransversalConfirmado",
                OnFailure = "CompleteEliminarTransversal('btnAgregar','preloader')",
                OnComplete = "CompleteEliminarTransversal('btnAgregar','preloader')"
            }, new { @id = "formEliminarTransversal" }))
            {
                <div class="modal-body">
                    <input type="hidden" id="identificador" name="identificador" />
                    <input type="hidden" id="descriptor" name="descriptor" />
                    <strong>¿Está seguro (a) que desea proceder?</strong>
                    <div id="error" class="alert alert-danger" style="display:none"></div>
                    <div id="dvAgregarEvidenciaTransversal"></div>
                    @Html.HiddenFor(model => model.Cargo.IdEntidad, new { @id = "cargo" })
                </div>
                <div class="modal-footer">
                    <input name="SubmitButton" class="btn btn-danger" type="submit" value="Eliminar" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>

@Scripts.Render("~/bundles/jquery")
<script src="~/Scripts/popper.min.js"></script>
@Scripts.Render("~/bundles/bootstrap")
<script src="~/Scripts/jquery.unobtrusive-ajax.js" type="text/javascript"></script>
<script src="~/Scripts/Pages/SearchMontoCaucion.js" type="text/javascript"></script>
<script src="~/Scripts/datetimepicker.js" type="text/javascript"></script>
<script src="~/Scripts/datetimepicker-es.js" type="text/javascript"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("body").tooltip({ selector: '[data-toggle=tooltip]' });
    });
</script>

