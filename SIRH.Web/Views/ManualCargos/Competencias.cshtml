        $("#" + btnId).show();
        $("#" + loaderId).hide();
    }

    function AgregarComportamientoTransversalConfirmado() {
        if ($('#modal-agregar-comportamiento #comportamiento').val() == "") {
            $("#modal-agregar-comportamiento #error").show();
            $("#modal-agregar-comportamiento #error").text("Debe digitar el comportamiento a agregar.");
            return false;
        }

        $("#modal-agregar-comportamiento #error").hide();
        return true;
    }

    function abrirAgregarEvidenciaTransversal(idComportamiento, tipoCompetencia, num) {
        $("#modal-agregar-evidencia").appendTo("body");
        $('#modal-agregar-evidencia').modal('show');
        $("#modal-agregar-evidencia #titulo").html("N° " + num + ", de la competencia " + (tipoCompetencia == 1 ? "Compromiso con el servicio público," : "Integridad en el desempeño de la función pública,"));
