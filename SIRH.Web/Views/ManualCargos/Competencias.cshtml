        $("#modal-agregar-evidencia #error").hide();
        return true;
    }

    function abrirEliminarTransversal(identificador, descriptor, num) {
        $("#modal-eliminar").appendTo("body");
        $('#modal-eliminar').modal('show');
        $("#modal-eliminar #titulo").html((descriptor == "comportamiento" ? ("el comportamiento N° " + num + " para esta competencia (Esta acción eliminará todas las evidencias asociadas).") : ("la evidencia N° " + num + " para este comportamiento")));
        $("#modal-eliminar #identificador").val(identificador);
        $("#modal-eliminar #descriptor").val(descriptor);
        return true;
    }

