<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sistema Integrado de Recursos Humanos</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="~/Content/font-awesome.min.css">
    <link rel="stylesheet" href="~/Content/sidebar.css">
</head>
<body>
    @{
        System.Security.Principal.WindowsPrincipal principal = new System.Security.Principal.WindowsPrincipal(System.Security.Principal.WindowsIdentity.GetCurrent());
    }
    <div class="container-fluid">
        <div class="row">
            <img class="embed-responsive" src="~/Content/Images/encabezadodiseno.jpg" width="100%" />
        </div>
    </div>
    <div class="wrapper">
        <!-- Opciones del sidebar -->
        <nav id="sidebar" class="navbar-collapse">
            <ul class="list-unstyled components">
                <li>
                    @Html.ActionLink("Inicio", "Index", "GestionContrato", null, new { @class = "colorlink" })
                </li>
                <li>
                    @Html.ActionLink("Solicitudes Pendientes", "Index", "ModuloJefatura", null, new { @class = "colorlink" })
                </li>
                <li>
                    @Html.ActionLink("Registro Movimiento Teletrabajo", "MovimientoTeletrabajo", "ModuloJefatura", null, new { @class = "colorlink" })
                </li>
                <li>
                    @Html.ActionLink("Registro Desempeño", "Desempeno", "ModuloJefatura", null, new { @class = "colorlink" })
                </li>
                <li>
                    @Html.ActionLink("Registro Tiempo Fuera", "TiempoFuera", "ModuloJefatura", null, new { @class = "colorlink" })
                </li>
                <li>
                    @Html.ActionLink("Dashboard", "Index", "DashboardDeTeletrabajo", null, new { @class = "colorlink" })
                </li>
            </ul>
        </nav>

        <div id="content">
            <nav class="navbar navbar-expand-lg navbar-light bg-light">
                <div class="container-fluid">
                    <button type="button" id="sidebarCollapse" class="navbar-btn">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <button class="btn btn-dark d-inline-block d-lg-none ml-auto" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <i class="fas fa-align-justify"></i>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="nav navbar-nav ml-auto align-items-center">
                           
                            <li class="nav-item active">
                                <a class="colorlink" href="@Url.Action("Perfil", "PerfilUsuario", new { @username = Session["NombreUsuario"] })">
                                    <i class="fa fa-user"></i> @(Session["NombreUsuario"])
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            @RenderBody()
        </div>
    </div>

    <div class="container-fluid">
        <div class="row">
            <img class="embed-responsive" src="~/Content/Images/pie-gris.png" />
        </div>
    </div>

    <script src="~/Scripts/sidebar.js" type="text/javascript"></script>
    <script>
        $("#btnBuscar").click(function () {
            var cedula = $("#cedula").val();

            if (!cedula) {
                alert("Ingrese una cédula");
                return;
            }

            $.ajax({
                url: '@Url.Action("BuscarPorCedula", "ModuloJefatura")',
                type: "POST",
                data: { cedula: cedula },
                success: function (data) {
                    $("#resultadoBusqueda").html(data);
                },
                error: function () {
                    $("#resultadoBusqueda").html("<div class='alert alert-danger'>Error al buscar funcionario.</div>");
                }
            });
        });
    </script>
</body>
</html>