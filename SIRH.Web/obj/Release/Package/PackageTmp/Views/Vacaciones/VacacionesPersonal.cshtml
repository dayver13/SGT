﻿@model SIRH.Web.ViewModels.FormularioRegistroVacacionesVM

@{ ViewBag.Title = "VacacionesPersonal";
    Layout = "~/Views/Shared/VacacionesGeneral.cshtml"; }
<link href="~/Content/datetimepicker.css" rel="stylesheet" />
<script src="~/Content/bootstrap-datepicker/js/jquery-3.4.1.slim.min.js"></script>
<!--link id="bs-css" href="https://netdna.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet"-->
<link id="bsdp-css" href="~/Content/bootstrap-datepicker/css/bootstrap-datepicker3.min.css" rel="stylesheet">

<h2>Solicitud de vacaciones</h2>


<div id="formulario">
    <div class="card">
        <div class="card-header">
            <strong>Información del Funcionario</strong>
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <tr>
                    <td>
                        <strong>@Html.LabelFor(model => model.Funcionario.Cedula): </strong>@Html.DisplayFor(model => model.Funcionario.Cedula)
                        @Html.HiddenFor(model => model.Funcionario.Cedula)
                    </td>
                    <td>
                        <strong>@Html.LabelFor(model => model.Funcionario.Nombre): </strong>@Model.Funcionario.Nombre @Model.Funcionario.PrimerApellido @Model.Funcionario.SegundoApellido
                         @Html.HiddenFor(model => model.Funcionario.Nombre)
                            @Html.HiddenFor(model => model.Funcionario.PrimerApellido)
                            @Html.HiddenFor(model => model.Funcionario.SegundoApellido)
                    </td>
                    <td>
                        <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion)
                        @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion)
                    </td>
                </tr>
                <tr>
                    <td>
                        <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision)
                        @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision)
                    </td>
                    <td>
                        <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento)
                        @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento)
                    </td>
                    <td>
                        <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion)
                        @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion)
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
<br />
@if(Model.PeriodosActivos.Count(x => x.Mensaje == "Pendientes") > 0)
{
    <div class="alert alert-danger">¡ATENCIÓN! Tiene registros de vacaciones pendientes de aprobación. Debe esperar a que finalice su gestión para solicitar vacaciones adicionales <br/> Puede revisarlos en la opción <strong>Mis solicitudes</strong></div>
}
else
{ 
<div class="jumbotron">
    @{
        using (Ajax.BeginForm("VacacionesPersonal", new AjaxOptions
        {
            UpdateTargetId = "Errores_Formulario",
            HttpMethod = "POST",
            OnSuccess = "SuccessCargarVacaciones",
            OnComplete = "CompleteCargarVacaciones",
            OnBegin = "BeginCargarVacaciones"
        }))
        {
            @Html.HiddenFor(model => model.Funcionario.Cedula)
            @Html.HiddenFor(model => model.PeriodoVacaciones.Periodo)
            Html.ValidationSummary(true);
            <div class="row">
                <div class="col-sm-8">
                    <div class="card">
                        <div class="card-header">
                            <strong>Formulario de registro de vacaciones</strong>
                        </div>

                        <div class="card-body">

                            <div class="form">
                                <div class="form-row">
                                    <div class="form-group  col-md-12">
                                        <span><b>@Html.LabelFor(model => model.RegistroVacaciones.Dias)</b></span>
                                        <div>
                                            @Html.TextBoxFor(model => model.RegistroVacaciones.Dias, new { @id = "dias", @class = "form-control col-2", @type = "number", @Value = "", @min = "0.5", @step = "0.5", @max = Model.PeriodosActivos.Sum(elem => Convert.ToDecimal(elem.Saldo)) })
                                            @Html.ValidationMessageFor(model => model.RegistroVacaciones.Dias)
                                            @Html.HiddenFor(model => model.Funcionario.Nombre)
                                            @Html.HiddenFor(model => model.Funcionario.PrimerApellido)
                                            @Html.HiddenFor(model => model.Funcionario.SegundoApellido)
                                            @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Seccion.IdEntidad)
                                            @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Division.IdEntidad)
                                            @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.IdEntidad)
                                            @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Departamento.IdEntidad)
                                        </div>
                                    </div>
                                    <div class="form-group col-4" id="divMediosDias" style="display:none;">
                                        <div class="d-inline col-4">
                                            @Html.Label("Medio día")<span class="col-2">:</span>
                                            Mañana
                                            @Html.RadioButtonFor(model => model.MedioDia, "Mañana")
                                            Tarde
                                            @Html.RadioButtonFor(model => model.MedioDia, "Tarde")
                                        </div>
                                        

                                    </div>
                                </div>

                                    <div class="form-row">
                                        <div class="form-group col-4">
                                            @Html.Label("Fecha de salida")
                                            <div class="start_date input-group mb-4">
                                                @Html.TextBoxFor(model => model.RegistroVacaciones.FechaRige, new { @id = "FechaRige", @class = "form-control start_date", @readonly = "readonly", @placeholder = "Fecha de Inicio" })
                                                @Html.ValidationMessageFor(model => model.RegistroVacaciones.FechaRige)
                                            </div>
                                            @Html.Label("Fecha de finalización")
                                            <div class="end_date input-group mb-4">
                                                <input id="FechaFinalizacion" class="form-control start_date" placeholder="Fecha de Finalización" readonly>

                                            </div>
                                            @Html.Label("Fecha de regreso")
                                            <div class="end_date input-group mb-4">
                                                @Html.TextBoxFor(model => model.RegistroVacaciones.FechaVence, new { @id = "FechaVence", @class = "form-control start_date", @readonly = "readonly", @placeholder = "Fecha de Regreso" })
                                                @Html.ValidationMessageFor(model => model.RegistroVacaciones.FechaVence)
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group col-4 mb-8">
                                            @Html.Label("Tipo de transacción:")
                                            @Html.DropDownListFor(model => model.tipoDocumentoSeleccion, Model.tipoDocumento, "Tipo transacción", new { @class = "form-control", @readonly = "readonly" })
                                            @Html.ValidationMessageFor(model => Model.tipoDocumentoSeleccion)
                                        </div>

                                        <!-- <div class="form-group  col-4">
                                            @Html.LabelFor(model => model.RegistroVacaciones.NumeroTransaccion)
                                            <span>:</span>
                                            @Html.TextBoxFor(model => model.RegistroVacaciones.NumeroTransaccion, new { @id = "numeroTransaccion", @class = "form-control", @placeholder = "###" })
                                            @Html.ValidationMessageFor(model => model.RegistroVacaciones.NumeroTransaccion)
                                            </div>-->
                                    </div>
                                </div>
                        </div>

                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="form">
                                <div class="form-row">
                                    <div class="form-group  col-md-6">
                                        @Html.Label("Periodo(s):")
                                    </div>
                                    <div class="form-group  col-md-2">
                                        @Html.Label("Saldo:")
                                    </div>
                                </div>
                                    @if (Model.PeriodosActivos != null)
                                    {
                                        for (int i = 0; i < Model.PeriodosActivos.Count; i++)
                                        {
                                        <div class="form-row">
                                            <div class="col-md-6">
                                                @Html.TextBoxFor(model => model.PeriodosActivos[i].Periodo, new {@id = "periodo", @class = "form-control", @readonly = "True" })
                                                @Html.ValidationMessageFor(model => model.PeriodosActivos[i].Periodo)
                                            </div>

                                            <div class="col-md-4">
                                                @Html.TextBoxFor(model => model.PeriodosActivos[i].Saldo, new {@id = "saldoPeriodo", @class = "form-control", @readonly = "True" })
                                                @Html.ValidationMessageFor(model => model.PeriodosActivos[i].Saldo)
                                            </div>
                                        </div>
                                        }
                                        <br/>
                                        <div class="form-row">
                                            <div class="col-md-6">
                                                <strong>Disponible:</strong>
                                            </div>
                                            <div class="col-md-4">
                                                @ViewBag.DiasTotales
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info">
                                            No se encontraron periodos activos para el funcionario
                                        </div>
                                    }
                                    
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <br>
            <div>
                <a class="btn btn-primary" href="javascript:history.back()" id="A5"><i class="fa fa-times"></i> Regresar</a>
                <button class="btn btn-success" id="btnGuardar" name="SubmitButton" type="submit" value="Guardar">
                    <i class="fa fa-save"></i>
                    Guardar
                </button>
            </div>
        }


<div id="Errores_Formulario" style="margin-top:15px;"> </div>}
</div>
}

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")
<script src="~/Scripts/sidebar.js" type="text/javascript"></script>
<script src="~/scripts/jquery.unobtrusive-ajax.js" type="text/javascript"></script>
<script src="~/Scripts/Pages/FormularioVacacionesPersonal.js" type="text/javascript"></script>
<script src="~/Scripts/datetimepicker.js" type="text/javascript"></script>
<script src="~/Scripts/datetimepicker-es.js" type="text/javascript"></script>
<script src="~/Content/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
<script src="~/Content/bootstrap-datepicker/locales/bootstrap-datepicker.es.min.js" charset="UTF-8"></script>
