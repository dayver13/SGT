@model SIRH.Web.ViewModels.FormularioRegistroVacacionesVM

@{
    ViewBag.Title = "AdministracionReintegros";
    Layout = "~/Views/Shared/VacacionesGeneral.cshtml";
}

<center><h2>Administración de reintegros de vacaciones</h2></center>

<br>
@if (@Model != null)
{
    <div id="tabs">
        @*<ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item">
                <a id="tab1" class="nav-link active" href="#tabs-1" data-toggle="tab" role="tab" aria-controls="tabs-1" aria-selected="true">Búsqueda por cédula</a>
