                                    </div>
                                </center>
                            </div>
                        </div>
                    }
                    <div id="dvResultadoBusquedaSeccion"></div> }
            </div>

            <div id="tabs-3" class="tab-pane fade" role="tabpanel" aria-labelledby="tab3">
                @{
                    Html.EnableClientValidation();
                    using (Html.BeginForm(Ajax.BeginForm("BuscarReintegrosPorDivision", "Vacaciones", new AjaxOptions
                    {
                        UpdateTargetId = "dvResultadoBusquedaDivision",
                        HttpMethod = "POST",
                        OnComplete = "CompleteCargarVacacionesDivision",
                        OnBegin = "BeginCargarVacacionesDivision"
                    })))
                    {
                        <div class="card">
                            <h5 class="card-header"></h5>
                            <div class="card-body">
                                <center>
                                    <div class="row">

                                        <form class="form-inline">
                                            <div class="col-2">

                                                <div class="form-group">
                                                    @Html.Label("División")
                                                </div>
                                            </div>
                                            <div class="col-3">
                                                <div class="form-group">
                                                    @Html.DropDownListFor(model => model.division,
                                                        Model.Divisiones, "División",
                                                        new
                                                             {
                                                                 @class = "form-control",
                                                        @readonly = "readonly"
                                                             })
                                                    @Html.ValidationMessageFor(model => model.Divisiones)
                                                </div>

                                            </div>
                                            <div class="col-2">
                                                <button class="btn btn-primary " id="btnBuscar" name="SubmitButton" type="submit" value="Buscar">
                                                    <i class="fa fa-search"></i>
                                                    Buscar
                                                </button>
                                            </div>
                                        </form>


                                    </div>

                                    <div class="row">

                                        <div class="col-10">
                                            <center>
                                                <div id="preloaderDivision" class="loader" hidden></div>
