                @{
                    Html.EnableClientValidation();
                    using (Html.BeginForm(Ajax.BeginForm("AdministracionReintegros", "Vacaciones", new AjaxOptions
                    {
                        UpdateTargetId = "dvResultadoBusqueda",
                        HttpMethod = "POST",
                        OnComplete = "CompleteCargarVacaciones",
                        OnBegin = "BeginCargarVacaciones"
                    })))
                    {
                        <div class="card">
                            <h5 class="card-header"></h5>
                            <div class="card-body">
                                <center>
                                    <div class="row">

                                        <form class="form-inline">
                                            <div class="col-4">

                                                <div class="form-group">
                                                    Seleccione el funcionario:
                                                </div>

                                            </div>
                                            <div class="col-3">
                                                <div class="form-group">
                                                    @Html.DropDownListFor(model => model.funcionarioSeleccionado,
                                                        Model.FuncionariosAsociados, "Seleccione...",
                                                        new
                                                        {
                                                            @class = "form-control",
                                                            @readonly = "readonly",
                                                            style = "width: 300px;"
                                                        })
                                                    @*@Html.TextBoxFor(model => model.PeriodoVacaciones.Nombramiento.Funcionario.Cedula, new { @class = "form-control", style = "margin-bottom:10px;", @maxlength = "10" })

                                                    @Html.ValidationMessageFor(model => model.PeriodoVacaciones.Nombramiento.Funcionario.Cedula)*@
                                                </div>
                                            </div>
                                            <div class="col-4">
                                                <button class="btn btn-primary " id="btnBuscar" name="SubmitButton" type="submit" value="Buscar">
                                                    <i class="fa fa-search"></i>
                                                    Buscar
                                                </button>
                                            </div>
                                        </form>

                                    </div>

                                    <div class="row">
                                        <div class="col-10">
                                            <center>
                                                <div id="preloader" class="loader" hidden></div>
                                            </center>
                                        </div>
                                    </div>
                                </center>
                            </div>
                        </div>
                    }
                    <div id="dvResultadoBusqueda"></div>
                }
            </div>
            @*<div id="tabs-2" class="tab-pane fade" role="tabpanel" aria-labelledby="tab2">
                @{
                    Html.EnableClientValidation();
                    using (Html.BeginForm(Ajax.BeginForm("BuscarReintegrosPorSeccion", "Vacaciones", new AjaxOptions
                    {
                        UpdateTargetId = "dvResultadoBusquedaSeccion",
                        HttpMethod = "POST",
                        OnComplete = "CompleteCargarVacacionesSeccion",
                        OnBegin = "BeginCargarVacacionesSeccion"
                    })))
                    {
                        <div class="card">
                            <h5 class="card-header"></h5>
                            <div class="card-body">
                                <center>
                                    <div class="row">

                                        <form class="form-inline">
                                            <div class="col-2">

                                                <div class="form-group">
                                                    @Html.Label("Sección")
                                                </div>
                                            </div>
                                            <div class="col-3">
                                                <div class="form-group">
                                                    @Html.DropDownListFor(model => model.seccion, Model.Secciones, "Sección", new { @class = "form-control", @readonly = "readonly" })
                                                    @Html.ValidationMessageFor(model => model.Secciones)
                                                </div>

                                            </div>
                                            <div class="col-2">
                                                <button class="btn btn-primary " id="btnBuscar" name="SubmitButton" type="submit" value="Buscar">
                                                    <i class="fa fa-search"></i>
                                                    Buscar
                                                </button>
                                            </div>
                                        </form>
                                    </div>

                                    <div class="row">

                                        <div class="col-10">
                                            <center>
                                                <div id="preloaderSeccion" class="loader" hidden></div>
                                            </center>
