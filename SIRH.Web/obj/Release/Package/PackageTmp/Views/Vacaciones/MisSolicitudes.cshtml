@model SIRH.Web.ViewModels.FormularioRegistroVacacionesVM
@{
    ViewBag.Title = "MisSolicitudes";
    Layout = "~/Views/Shared/VacacionesGeneral.cshtml";
}

<h2>Mis Solicitudes</h2>
@if (Session["VacacionesActivo"] != null)
{
    <div class="alert alert-success">Vacaciones solicitadas con éxito!</div>
}
<br />
<div id="formulario">
    <div class="card">
        <div class="card-header">
            <strong>Información del Funcionario</strong>
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <tr>
                    <td>
                        <strong>@Html.LabelFor(model => model.Funcionario.Cedula): </strong>@Html.DisplayFor(model => model.Funcionario.Cedula)
                        @Html.HiddenFor(model => model.Funcionario.Cedula)
                    </td>
                    <td>
                        <strong>@Html.LabelFor(model => model.Funcionario.Nombre): </strong>@Model.Funcionario.Nombre @Model.Funcionario.PrimerApellido @Model.Funcionario.SegundoApellido
                        @Html.HiddenFor(model => model.Funcionario.Nombre)
                        @Html.HiddenFor(model => model.Funcionario.PrimerApellido)
                        @Html.HiddenFor(model => model.Funcionario.SegundoApellido)
                    </td>
                    <td>
                        <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion)
                        @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.NomDireccion)
                    </td>
                </tr>
                <tr>
                    <td>
                        <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision)
                        @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Division.NomDivision)
                    </td>
                    <td>
                        <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento)
                        @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Departamento.NomDepartamento)
                    </td>
                    <td>
                        <strong>@Html.LabelFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion): </strong>@Html.DisplayFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion)
                        @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Seccion.NomSeccion)
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
<br />
<br>
@if (@Model != null)
{


    <div id="tabs">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item">
                <a id="tab1" class="nav-link @(Session["VacacionesActivo"] != null ? "" : "active")" href="#tabs-1" data-toggle="tab" role="tab" aria-controls="tabs-1" aria-selected="true"> Aprobadas</a>
            </li>
            <li class="nav-item">
                <a id="tab2" class="nav-link @(Session["VacacionesActivo"] != null ? "active" : "")" href="#tabs-2" data-toggle="tab" role="tab" aria-controls="tabs-2" aria-selected="false"> Pendientes</a>
            </li>
            <li class="nav-item">
                <a id="tab3" class="nav-link" href="#tabs-3" data-toggle="tab" role="tab" aria-controls="tabs-3" aria-selected="false">Rechazadas</a>
            </li>
            <li class="nav-item">
                <a id="tab3" class="nav-link" href="#tabs-4" data-toggle="tab" role="tab" aria-controls="tabs-4" aria-selected="false">Anuladas</a>
            </li>
        </ul>
        <div class="tab-content" id="myTabContent">
            <div id="tabs-1" class="tab-pane fade @(Session["VacacionesActivo"] != null ? "" : "show active")" role="tabpanel" aria-labelledby="tab1">
                @if (@Model.ListaRegistroVacacionesAprobadas != null && Model.ListaRegistroVacacionesAprobadas.Count > 0)
                {
                    <table class="table table-striped table-hover" id="tablaFacturas" style="margin-bottom:70px;">
                        <thead>

                            <tr>
                                <th>Num Solicitud</th>
                                <th>Fecha Salida</th>
                                <th>Fecha Regreso</th>
                                <th>Cantidad Días</th>

                                <th> <!-- boton detalle--></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int p = 0; p < Model.ListaPeriodos.Count; p++)
                            {
                                <tr class="table-secondary">
                                    <td class="border-bottom border-primary" colspan="6"><strong>Periodo @Model.ListaPeriodos[p] </strong></td>

                                </tr>
                                for (int i = 0; i < Model.ListaRegistroVacacionesAprobadas.Count; i++)
                                {




                                    if (@Model.ListaPeriodos[p] == @Model.ListaRegistroVacacionesAprobadas[i].Periodo.Periodo)
                                    {
                                        <tr class="omitir">


                                            <td class="border-bottom border-success">@Model.ListaRegistroVacacionesAprobadas[i].NumeroTransaccion</td>
                                            <td class="border-bottom border-success">@Model.ListaRegistroVacacionesAprobadas[i].FechaRige.ToShortDateString()</td>
                                            <td class="border-bottom border-success">@Model.ListaRegistroVacacionesAprobadas[i].FechaVence.ToShortDateString()</td>
                                            <td class="border-bottom border-success">@Model.ListaRegistroVacacionesAprobadas[i].Dias</td>
                                            <td class="border-bottom border-success"><button class="btn btn-outline-info" onclick="abrirDetalles(@(Model.ListaRegistroVacacionesAprobadas[i].IdEntidad), '@(Model.ListaRegistroVacacionesAprobadas[i].NumeroTransaccion)', '@(Model.ListaRegistroVacacionesAprobadas[i].Dias.ToString())', '@(Model.ListaRegistroVacacionesAprobadas[i].FechaRige.ToShortDateString().ToString())','@(Model.ListaRegistroVacacionesAprobadas[i].FechaVence.ToShortDateString().ToString())','@(Model.ListaRegistroVacacionesAprobadas[i].TipoTransaccion)','@(Model.ListaRegistroVacacionesAprobadas[i].Estado)');" id="btnDetalles"> Detalles  <i class="fa fa-paperclip"></i></button></td>
                                            <td class="border-bottom border-success"><button class="btn btn-outline-dark" onclick="AbrirReintegroVacaciones(@(Model.ListaRegistroVacacionesAprobadas[i].IdEntidad), '@(Model.ListaRegistroVacacionesAprobadas[i].NumeroTransaccion)', '@(Model.ListaRegistroVacacionesAprobadas[i].Dias.ToString())', '@(Model.ListaRegistroVacacionesAprobadas[i].FechaRige.ToShortDateString())','@(Model.ListaRegistroVacacionesAprobadas[i].FechaVence.ToShortDateString())','@(Model.ListaPeriodos[p])');" id="btnReintegrar"><i class="fa fa-backward"></i>  Solicitar Reintegro</button></td>


                                        </tr>
                                    }

                                }
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">No se encontraron Registros de vacaciones Aporbados para el Funcionario </div>
                }
            </div>
            <div id="tabs-2" class="tab-pane fade @(Session["VacacionesActivo"] != null ? "show active" : "")" role="tabpanel" aria-labelledby="tab2">
                @if (@Model.ListaRegistroVacacionesPendientes != null && Model.ListaRegistroVacacionesPendientes.Count > 0)
                {
                    <table class="table table-striped table-hover" id="tablaFacturas" style="margin-bottom:70px;">
                        <thead>
                            <tr>
                                <th>Num Solicitud</th>
                                <th>Fecha Salida</th>
                                <th>Fecha Regreso</th>
                                <th>Cantidad Dias</th>
                                <th> <!-- boton detalle--></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>


                            @for (int i = 0; i < Model.ListaRegistroVacacionesPendientes.Count; i++)
                            {



                                <tr class="omitir">

                                    <td class="border-bottom border-success">@Model.ListaRegistroVacacionesPendientes[i].NumeroTransaccion</td>
                                    <td class="border-bottom border-success">@Model.ListaRegistroVacacionesPendientes[i].FechaRige.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaRegistroVacacionesPendientes[i].FechaVence.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaRegistroVacacionesPendientes[i].Dias</td>

                                    <td class="border-bottom border-success"><button class="btn btn-outline-danger" onclick="abrirCancelarRegistro2(@(Model.ListaRegistroVacacionesPendientes[i].IdEntidad), '@(Model.ListaRegistroVacacionesPendientes[i].NumeroTransaccion)', '@(Model.ListaRegistroVacacionesPendientes[i].Dias.ToString())', '@(Model.ListaRegistroVacacionesPendientes[i].FechaRige.ToShortDateString().ToString())','@(Model.ListaRegistroVacacionesPendientes[i].FechaVence.ToShortDateString().ToString())');" id="btncancelar"> Anular  <i class="fa fa-window-close"></i></button></td>
                                    <td class="border-bottom border-success"><button class="btn btn-outline-info" onclick="abrirDetalles(@(Model.ListaRegistroVacacionesPendientes[i].IdEntidad), '@(Model.ListaRegistroVacacionesPendientes[i].NumeroTransaccion)', '@(Model.ListaRegistroVacacionesPendientes[i].Dias.ToString())', '@(Model.ListaRegistroVacacionesPendientes[i].FechaRige.ToShortDateString().ToString())','@(Model.ListaRegistroVacacionesPendientes[i].FechaVence.ToShortDateString().ToString())','@(Model.ListaRegistroVacacionesPendientes[i].TipoTransaccion)','@(Model.ListaRegistroVacacionesPendientes[i].Estado)');" id="btnDetalles"> Detalles  <i class="fa fa-paperclip"></i></button></td>

                                    <td class="border-bottom border-success">
                                        @if (Model.ListaRegistroVacacionesPendientes[i].Estado == 6)
                                        {
                                            <label>En discusión - </label>
                                            <button type="button" class="btn btn-warning"
                                                    onclick="abrirDiscusionRegistro(@(Model.ListaRegistroVacacionesPendientes[i].IdEntidad),
                                                                                    '@(Model.ListaRegistroVacacionesPendientes[i].NumeroTransaccion.ToString())',
                                                                                    '@(Model.ListaRegistroVacacionesPendientes[i].Dias.ToString())',
                                                                                    '@(Model.ListaRegistroVacacionesPendientes[i].FechaRige.ToShortDateString().ToString())',
                                                                                    '@(Model.ListaRegistroVacacionesPendientes[i].FechaVence.ToShortDateString().ToString())',
                                                                                    '@(Model.ListaRegistroVacacionesPendientes[i].Periodo.Nombramiento.Funcionario.Cedula.ToString())',
                                                                                    '@(Model.ListaRegistroVacacionesPendientes[i].Periodo.Nombramiento.Funcionario.Nombre.ToString())',
                                                                                    '@(Model.ListaRegistroVacacionesPendientes[i].Periodo.Nombramiento.Funcionario.PrimerApellido.ToString())',
                                                                                    '@(Model.ListaRegistroVacacionesPendientes[i].Periodo.Nombramiento.Funcionario.SegundoApellido.ToString())');"
                                                    id="btnDiscusion">
                                                <i class="fa fa-reply"></i> Responder
                                            </button>
                                        }
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">No se encontraron Registros de vacaciones Pendientes para el Funcionario </div>
                }
            </div>
            <div id="tabs-3" class="tab-pane fade" role="tabpanel" aria-labelledby="tab3">
                @if (@Model.ListaRegistroVacacionesRechazadas != null && Model.ListaRegistroVacacionesRechazadas.Count > 0)
                {
                    <table class="table table-striped table-hover" id="tablaFacturas" style="margin-bottom:70px;">
                        <thead>
                            <tr>
                                <th>Num Solicitud</th>
                                <th>Fecha Salida</th>
                                <th>Fecha Regreso</th>
                                <th>Cantidad Dias</th>
                                <th> <!-- boton detalle--></th>
                            </tr>
                        </thead>
                        <tbody>


                            @for (int i = 0; i < Model.ListaRegistroVacacionesRechazadas.Count; i++)
                            {



                                <tr class="omitir">

                                    <td class="border-bottom border-success">@Model.ListaRegistroVacacionesRechazadas[i].NumeroTransaccion</td>
                                    <td class="border-bottom border-success">@Model.ListaRegistroVacacionesRechazadas[i].FechaRige.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaRegistroVacacionesRechazadas[i].FechaVence.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaRegistroVacacionesRechazadas[i].Dias</td>
                                    <td class="border-bottom border-success"><button class="btn btn-outline-info" onclick="abrirDetalles(@(Model.ListaRegistroVacacionesRechazadas[i].IdEntidad), '@(Model.ListaRegistroVacacionesRechazadas[i].NumeroTransaccion)', '@(Model.ListaRegistroVacacionesRechazadas[i].Dias.ToString())', '@(Model.ListaRegistroVacacionesRechazadas[i].FechaRige.ToShortDateString().ToString())','@(Model.ListaRegistroVacacionesRechazadas[i].FechaVence.ToShortDateString().ToString())','@(Model.ListaRegistroVacacionesRechazadas[i].TipoTransaccion)','@(Model.ListaRegistroVacacionesRechazadas[i].Estado)');" id="btnDetalles"> Detalles  <i class="fa fa-paperclip"></i></button></td>
                                    <td class="border-bottom border-success">
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">No se encontraron Registros de vacaciones Rechazados para el Funcionario </div>
                }
            </div>
            <div id="tabs-4" class="tab-pane fade" role="tabpanel" aria-labelledby="tab4">
                @if (@Model.ListaRegistroVacacionesAnuladas != null && Model.ListaRegistroVacacionesAnuladas.Count > 0)
                {
                    <table class="table table-striped table-hover" id="tablaFacturas" style="margin-bottom:70px;">
                        <thead>
                            <tr>
                                <th>Num Solicitud</th>
                                <th>Fecha Salida</th>
                                <th>Fecha Regreso</th>
                                <th>Cantidad Dias</th>
                                <th> <!-- boton detalle--></th>
                            </tr>
                        </thead>
                        <tbody>


                            @for (int i = 0; i < Model.ListaRegistroVacacionesAnuladas.Count; i++)
                            {



                                <tr class="omitir">

                                    <td class="border-bottom border-success">@Model.ListaRegistroVacacionesAnuladas[i].NumeroTransaccion</td>
                                    <td class="border-bottom border-success">@Model.ListaRegistroVacacionesAnuladas[i].FechaRige.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaRegistroVacacionesAnuladas[i].FechaVence.ToShortDateString()</td>
                                    <td class="border-bottom border-success">@Model.ListaRegistroVacacionesAnuladas[i].Dias</td>
                                    <td class="border-bottom border-success"><button class="btn btn-outline-info" onclick="abrirDetalles(@(Model.ListaRegistroVacacionesAnuladas[i].IdEntidad), '@(Model.ListaRegistroVacacionesAnuladas[i].NumeroTransaccion)', '@(Model.ListaRegistroVacacionesAnuladas[i].Dias.ToString())', '@(Model.ListaRegistroVacacionesAnuladas[i].FechaRige.ToShortDateString().ToString())','@(Model.ListaRegistroVacacionesAnuladas[i].FechaVence.ToShortDateString().ToString())','@(Model.ListaRegistroVacacionesAnuladas[i].TipoTransaccion)','@(Model.ListaRegistroVacacionesAnuladas[i].Estado)');" id="btnDetalles"> Detalles  <i class="fa fa-paperclip"></i></button></td>
                                    <td class="border-bottom border-success">
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">No se encontraron Registros de vacaciones Anulados para el Funcionario </div>
                }
            </div>

        </div>
    </div>
    <br />

}
else
{
    <div class="alert alert-warning">El Funcionario no presenta ningún Registro Relacionado a Vacaciones</div>
}
<a class="btn btn-primary" href="Index" id="A5"><i class="fa fa-arrow-circle-left"></i> Regresar</a>


<!--MODAL CANCELAR-->
<div class="modal fade" id="modal-cancelar" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header alert alert-danger" role="alert">
                <h5 class="modal-title" id="exampleModalCenterTitle">
                    <i class="fa fa-exclamation-circle d-inline" style="font-size:25px;"></i>
                    ¡Atención! Usted está apunto de anular el registro de vacaciones <strong id="numDocumento"></strong> del funcionario <strong>@Model.Funcionario.Cedula - @Model.Funcionario.Nombre @Model.Funcionario.PrimerApellido @Model.Funcionario.SegundoApellido</strong>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Ajax.BeginForm("AnularRegistro", "Vacaciones", new AjaxOptions
            {
                HttpMethod = "Post",
                UpdateTargetId = "dvResultadoCancelado",
                OnBegin = "CancelarRegistroConfirmado",
                OnFailure = "CompleteCancelarRegistro('btncancelar','preloader')",
                OnComplete = "CompleteCancelarRegistro('btncancelar','preloader')"
            }, new { @id = "formCancelarRegistro" }))
            {
                <div class="modal-body">
                    <input type="hidden" id="dias" />
                    <input type="hidden" id="idRegistro" name="identRegistro" />

                    <table class="table table-hover">
                        <tr>
                            <td>Nº Solicitud</td>
                            <td>Fecha de salida</td>
                            <td>Fecha de regreso</td>
                            <td>Dias a aprobar</td>
                        </tr>

                        <tr>
                            <td><div id="solicitud"></div></td>
                            <td><div id="fechaSalida"></div></td>
                            <td><div id="fechaEntrada"></div></td>
                            <td><div id="dias"></div></td>
                        </tr>
                    </table>
                    <div id="error" class="alert alert-danger" style="display:none"></div>
                    @*@Html.HiddenFor(model => model.Periodo.Periodo, new { @id = "periodo" })
                        @Html.HiddenFor(model => model.Periodo.IdEntidad, new { @id = "identperiodo" })*@
                    @Html.HiddenFor(model => model.Funcionario.Cedula, new { @id = "cedula" })
                    @Html.HiddenFor(model => model.PeriodosActivos.Count)

                </div>
                <div class="modal-footer">
                    <input name="SubmitButton" class="btn btn-primary" type="submit" value="Guardar" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>

<!--MODAL DETALLES-->
<div class="modal fade" id="modal-detalles" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header alert alert-info" role="contentinfo">
                <h5 class="modal-title" id="exampleModalCenterTitle">
                    <i class="fa fa-info-circle d-inline" style="font-size:25px;"></i>
                    Información de la Solicitud <strong id="numDocumento"></strong> del funcionario <strong>@Model.Funcionario.Cedula - @Model.Funcionario.Nombre @Model.Funcionario.PrimerApellido @Model.Funcionario.SegundoApellido</strong>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Ajax.BeginForm("MostrarDetalles", "Vacaciones", new AjaxOptions
            {
                HttpMethod = "Post",
                UpdateTargetId = "dvResultadoCancelado",
                OnBegin = "CancelarDetallesConfirmado",
                OnFailure = "CompleteCancelarDetalles('btnDetalles','preloader')",
                OnComplete = "CompleteCancelarDetalles('btnDetalles','preloader')"
            }, new { @id = "formCancelarRegistro" }))
            {
                <div class="modal-body">
                    <input type="hidden" id="dias" />
                    <input type="hidden" id="idRegistro" name="identRegistro" />

                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Fecha Inicio</th>
                                <th>Fecha Fin</th>
                                <th>Días</th>
                                <th>Tipo de Transacción</th>
                                <th>N° de Documento</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><div id="fechaSalida"></div></td>
                                <td><div id="fechaEntrada"></div></td>
                                <td><div id="dias"></div></td>
                                <td><div id="tipoTransaccion"></div></td>
                                <td><div id="solicitud"></div></td>
                                <td><div id="estado"></div></td>
                            </tr>
                        </tbody>

                    </table>
                    <div id="info" class="alert alert-info" style="display:none"></div>
                    @*@Html.HiddenFor(model => model.Periodo.Periodo, new { @id = "periodo" })
                        @Html.HiddenFor(model => model.Periodo.IdEntidad, new { @id = "identperiodo" })*@
                    @Html.HiddenFor(model => model.Funcionario.Cedula, new { @id = "cedula" })
                    @Html.HiddenFor(model => model.PeriodosActivos.Count)
                    @Html.HiddenFor(model => model.RegistroVacaciones.IdEntidad, new { @id = "idregistrovacaciones" })
                    @Html.HiddenFor(model => model.RegistroVacaciones.Dias, new { @id = "cantidaddias" })
                </div>

            }
        </div>
    </div>
</div>


<!--MODAL REINTEGRO-->

<div class="modal fade" id="modal-reintegro" tabindex="1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header alert alert-info" role="contentinfo">
                <h5 class="modal-title" id="exampleModalCenterTitle">
                    <i class="fa fa-exclamation-circle d-inline" style="font-size:25px;"></i>
                    ¡Atención! Usted está apunto de reintegrar el registro de vacaciones <strong id="numDocumento">@Model.RegistroVacaciones.NumeroTransaccion</strong> del funcionario <strong>@Model.Funcionario.Cedula - @Model.Funcionario.Nombre @Model.Funcionario.PrimerApellido @Model.Funcionario.SegundoApellido</strong>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Ajax.BeginForm("ReintegrarVacaciones", "Vacaciones", new AjaxOptions
            {
                HttpMethod = "POST",
                UpdateTargetId = "dvResultadoReintegro",
                OnBegin = "BeginCargarReintegro",
                OnFailure = "CompleteCargarReintegro('btnReintegrar','preloader')",
                OnComplete = "CompleteCargarReintegro('btnReintegrar', 'preloader')",
                OnSuccess = "ReintegrarVacaciones"
            }, new { @id = "formSolicitarReintegro" }))
            {
                <div class="modal-body">

                    <input type="hidden" id="fechaInicioOriginal" name="fechaInicioOriginal" />
                    <input type="hidden" id="fechaFinOriginal" name="fechaFinOriginal" />
                    <input type="hidden" id="diasOriginal" />
                    <input type="hidden" id="idRegistro" name="identRegistro" />
                    <strong>Seleccione la cantidad de días a reintegrar, junto con la fecha de rige y vence correspondientes.</strong>
                    <table class="table table-hover">
                        <tr>
                            <td>Fecha inicio registro</td>
                            <td>Fecha fin registro</td>
                            <td>Días registro</td>
                            <td><b>Fecha inicio reintegro</b></td>
                            <td><b>Fecha fin reintegro</b></td>
                            <td><b>Días reintegro</b></td>
                            <
                            <td><b>Documento reintegro</b></td>
                        </tr>

                        <tr>
                            <td><div id="fechaInicio"></div></td>
                            <td><div id="fechaFin"></div></td>
                            <td><div id="dias"></div></td>
                            <td>@Html.TextBoxFor(model => model.ReintegroVacaciones.FechaRige, new { @id = "fecInicio", @class = "form-control start_date", @readonly = "readonly", @placeholder = "Fecha de Inicio" })</td>
                            <td>@Html.TextBoxFor(model => model.ReintegroVacaciones.FechaVence, new { @id = "fecFin", @class = "form-control end_date", @readonly = "readonly", @placeholder = "Fecha de Finalización" })</td>
                            <td>@Html.TextBoxFor(model => model.ReintegroVacaciones.CantidadDias, new { @id = "diasReintegro", @class = "form-control", @type = "number", @min = "0.5", @step = "0.5", @Value = "" })</td>
                            <td>@Html.TextBoxFor(model => model.ReintegroVacaciones.SolReintegro, new { @id = "docReintegro", @class = "form-control", @pattern = "[a-zA-Z0-9_-]{1,25}" })</td>
                            @Html.HiddenFor(model => model.Funcionario.Nombre)
                            @Html.HiddenFor(model => model.Funcionario.PrimerApellido)
                            @Html.HiddenFor(model => model.Funcionario.SegundoApellido)
                            @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Seccion.IdEntidad)
                            @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Division.IdEntidad)
                            @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.IdEntidad)
                            @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Departamento.IdEntidad)

                        </tr>
                        <tr>
                            <td colspan="2"><b>Observaciones</b></td>
                            <td colspan="5">@Html.TextAreaFor(model => model.ReintegroVacaciones.Observaciones, new { @id = "obsReintegro", @class = "form-control", @placeholder = "Observaciones", @Value = "" })</td>
                            @*<td colspan="5"><textarea id="obsReintegro" class="form-control" name="obsReintegro"></textarea></td>*@
                        </tr>
                    </table>
                    <div id="error" class="alert alert-danger" style="display:none"></div>
                    <div id="dvResultadoReintegro"></div>
                    @Html.HiddenFor(model => model.Funcionario.Cedula, new { @id = "cedula" })
                    @Html.HiddenFor(model => model.PeriodosActivos.Count)
                    @Html.HiddenFor(model => model.RegistroVacaciones.IdEntidad, new { @id = "idregistrovacaciones" })
                    @Html.HiddenFor(model => model.RegistroVacaciones.NumeroTransaccion, new { @id = "numDocumento" })
                    @Html.HiddenFor(model => model.PeriodoVacaciones.Periodo, new { @id = "periodo" })

                </div>
                <div class="modal-footer">
                    <input name="SubmitButton" class="btn btn-primary" type="submit" value="Reintegrar" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="LimpiarModalReintegro()">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>

<!--MODAL DISCUSION-->
<div class="modal fade" id="modal-discusion" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header alert alert-warning" role="alert">
                <h5 class="modal-title" id="exampleModalCenterTitle">
                    <i class="fa fa-exclamation-circle d-inline" style="font-size:25px;"></i>
                    ¡Atención! Usted está apunto de someter a discusion el registro de vacaciones <strong id="numDocumento"></strong> del funcionario <strong id="cedula"></strong> - <strong id="nomFuncionario"></strong> <strong id="primerApellido"></strong> <strong id="segundoApellido"></strong>
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Ajax.BeginForm("ActualizarSolicitud", "Vacaciones", new AjaxOptions
            {
                HttpMethod = "Post",
                UpdateTargetId = "dvResultadoDiscusion",
                OnBegin = "DiscusionRegistroConfirmado",
                OnFailure = "CompleteDiscusionRegistro('btndiscusion','preloader')",
                OnComplete = "CompleteDiscusionRegistro('btndiscusion','preloader')"
            }, new { @id = "formDiscusionRegistro" }))
            {
                <div class="modal-body">
                    <input type="hidden" id="Solicitud" name="Solicitud" value="" />
                    <input type="hidden" id="Cedula" name="Cedula" value="" />
                    <strong>Escriba un comentario para someter a discusión la solicitud.</strong>
                    <table class="table table-hover">
                        <tr>
                            <td>Nº Transacción</td>
                            <td>Fecha Rige</td>
                            <td>Fecha Vence</td>
                            <td>Días a aprobar</td>
                        </tr>

                        <tr>
                            <td><div id="numDocumento"></div></td>
                            <td><div id="fechaSalida"></div></td>
                            <td><div id="fechaEntrada"></div></td>
                            <td><div id="dias"></div></td>
                        </tr>
                    </table>
                    <div class="form-group">
                        <label for="comment"> Comentario: </label>
                        @Html.TextAreaFor(model => model.RegistroVacaciones.Comentario, new { @class = "form-control", @size = 50, @placeholder = "Comentario" })
                    </div>
                    <div id="error" class="alert alert-danger" style="display:none"></div>
                    @*@Html.HiddenFor(model => model.Periodo.Periodo, new { @id = "periodo" })
        @Html.HiddenFor(model => model.Periodo.IdEntidad, new { @id = "identperiodo" })*@
                    @Html.HiddenFor(model => model.Funcionario.Cedula)
                    @Html.HiddenFor(model => model.Funcionario.Nombre)
                    @Html.HiddenFor(model => model.Funcionario.PrimerApellido)
                    @Html.HiddenFor(model => model.Funcionario.SegundoApellido)
                    @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Seccion.IdEntidad)
                    @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Division.IdEntidad)
                    @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.DireccionGeneral.IdEntidad)
                    @Html.HiddenFor(model => model.Puesto.UbicacionAdministrativa.Departamento.IdEntidad)
                    @Html.HiddenFor(model => model.PeriodosActivos.Count)
                </div>
                <div class="modal-footer">
                    <input name="SubmitButton" class="btn btn-primary" type="submit" value="Responder" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>

