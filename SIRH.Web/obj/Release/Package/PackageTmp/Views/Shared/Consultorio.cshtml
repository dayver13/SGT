@using System.Security.Principal
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sistema Integrado de Recursos Humanos</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="~/Content/font-awesome.min.css">
    <link rel="stylesheet" href="~/Content/sidebar.css">
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <img class="embed-responsive" src="~/Content/Images/EncabezadoCauciones.png"/>
    </div>
</div>
<div class="wrapper">
    <nav id="sidebar">
        <ul class="list-unstyled components">
            <li>
                @Html.ActionLink("Inicio SIRH", "Index", "Home", null, new { @class = "colorlink" })
            </li>
            <li>
                @Html.ActionLink("Inicio", "Index", "Consultorio", null, new { @class = "colorlink" })
            </li>
            <li>
                <a class="colorlink" href="#submenu1" data-toggle="collapse" data-target="#submenu1">Gestión de Citas Médicas</a>
                <div class="collapse" id="submenu1" aria-expanded="false">
                    <ul class="list-unstyled components">
                        <li>
                            @Html.ActionLink("Agregar Citas Médicas", "CreateAppointment", "Consultorio", null, new { @class = "text-center colorlink" })
                        </li>
                        <li>
                            @Html.ActionLink("Listar Citas Médicas", "Search", "Consultorio", null, new { @class = "text-center colorlink" })
                        </li>
                    </ul>
                </div>
            </li>
            <li>
                <a class="colorlink" href="#submenu2" data-toggle="collapse" data-target="#submenu2">Gestión de Notificaciones</a>
                <div class="collapse" id="submenu2" aria-expanded="false">
                    <ul class="list-unstyled components">

                        <li>
                            @Html.ActionLink("Notificar Pacientes", "Notify", "Consultorio", null, new { @class = "text-center colorlink" })
                        </li>

                    </ul>
                </div>
            </li>
            <li>
                <a class="colorlink" href="#submenu3" data-toggle="collapse" data-target="#submenu3">Gestión de Expendientes Médicos</a>
                <div class="collapse text-center" id="submenu3" aria-expanded="false">
                    <ul class="list-unstyled components">

                        <li>
                            @Html.ActionLink("Registrar Expediente Médico", "CreateMedicalRecord", "Consultorio", null, new { @class = "text-center colorlink" })
                        </li>
                        <li>
                            @Html.ActionLink("Consultar Expediente Médico", "SearchExpedienteMedico", "Consultorio", null, new { @class = "text-center colorlink" })
                        </li>
                    </ul>
                </div>
            </li>
            <li>
                <a class="colorlink" href="#submenu4" data-toggle="collapse" data-target="#submenu4">Gestión de Horarios</a>
                <div class="collapse text-center" id="submenu4" aria-expanded="false">
                    <ul class="list-unstyled components">

                    </ul>
                </div>
            </li>
            <li>
                <a class="colorlink" href="#submenu5" data-toggle="collapse" data-target="#submenu5">Gestión de Documentos Varios</a>
                <div class="collapse text-center" id="submenu5" aria-expanded="false">
                    <ul class="list-unstyled components">

                    </ul>
                </div>
            </li>
        </ul>
    </nav>
    @{
        var principal = new WindowsPrincipal(WindowsIdentity.GetCurrent());
    }

    <div id="content">
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container-fluid">
                <button type="button" id="sidebarCollapse" class="navbar-btn">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <button class="btn btn-dark d-inline-block d-lg-none ml-auto" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fas fa-align-justify"></i>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="nav navbar-nav ml-auto">
                        <li class="nav-item active">
                            <a class="colorlink" href="@Url.Action("Perfil", "PerfilUsuario", new { username = principal.Identity.Name })">
                                <i class="fa fa-user"></i> @principal.Identity.Name
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        @RenderBody()
    </div>
</div>
<div class="container-fluid">
    <div class="row">
        <img class="embed-responsive" src="~/Content/Images/pie-oscuro.png"/>
    </div>
</div>
<script src="~/Scripts/sidebar.js" type="text/javascript"></script>
</body>
</html>