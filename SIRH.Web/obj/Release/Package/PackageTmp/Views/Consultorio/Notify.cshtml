@model SIRH.Web.ViewModels.NotificacionUsuarioVM



@{
    ViewBag.Title = "Notify";
    Layout = "~/Views/Shared/Consultorio.cshtml";
}
<link rel="stylesheet" href="~/Content/datetimepicker.css">


@using (Ajax.BeginForm("Notify", "Consultorio", new AjaxOptions
{
    HttpMethod = "Post",
    UpdateTargetId = "dvNotificacion",
    InsertionMode = InsertionMode.Replace,
    OnBegin = "BeginNotificarConsultorio",
    OnComplete = "CompleteNotificarConsultorio",
    OnSuccess = "SuccesNotificarConsultorio",
}))
{
    <div class="jumbotron">
        <div style="text-align: center;">
            <h3 class="display-4">Enviar notificación a pacientes</h3>
            <br />
            <center>
                <div class="card">
                    <div class="card-header text-left">
                        Digite el número de cédula del destinatario
                    </div>

                    <div class="card-body">

                        <div class="form-group">
                            @Html.TextBoxFor(model => model.Funcionario.Cedula, new { @class = "form-control", placeholder = "Cédula", style = "width: 280px;" })
                            @Html.ValidationMessageFor(model => model.Funcionario.Cedula)
                        </div>
                        <input id="btnBuscar" name="SubmitButton" class="btn btn-primary" type="submit" value="Buscar" />
                        <div id="preloader" class="loader" style="display: none"></div>

                    </div>
                </div>
            </center>
        </div>
    </div>
}

<div id="dvNotificacion"></div>


@Scripts.Render("~/bundles/jquery")
<script src="~/Scripts/popper.min.js"></script>
@Scripts.Render("~/bundles/bootstrap")
<script src="~/Scripts/jquery.unobtrusive-ajax.js" type="text/javascript"></script>
<script src="~/Scripts/Pages/FormularioConsultorio.js" type="text/javascript"></script>

