@model SIRH.Web.ViewModels.BusquedaConsultorioVM

@{
    ViewBag.Title = "SearchExpedienteMedico";
    Layout = "~/Views/Shared/Consultorio.cshtml";
}

@using (Ajax.BeginForm("SearchExpedienteMedico", "Consultorio", new AjaxOptions
{
    HttpMethod = "Post",
    UpdateTargetId = "dvCreateMedicalRecord",
    InsertionMode = InsertionMode.Replace,
    OnSuccess = "SuccesBusquedaExpedienteMedico",
    OnComplete = "CompleteBusquedaExpedienteMedico",
    OnBegin = "BeginBusquedaExpedienteMedico"
}))
{
    <div class="jumbotron">
        <center>
            <h3 class="display-4">Consulta de Expedientes Médicos</h3>
            <br/>
            <div class="card">
                <div class="card-header text-left">
                    Filtro de búsqueda
                </div>
                <div class="card-body">

                    <div class="form-group">
                        @Html.TextBoxFor(model => model.Funcionario.Cedula, new { @class = "form-control", placeholder = "Cédula", style = "width: 280px;" })
                        @Html.ValidationMessageFor(model => model.Funcionario.Cedula)
                    </div>
                    <div class="d-inline ">
                        <input id="btnBuscar" name="SubmitButton" class="btn btn-primary" type="submit" value="Buscar"/>
                    </div>
                    <div id="preloader" class="loader" style="display: none"></div>

                </div>
            </div>

        </center>
    </div>
}

<div id="dvCreateMedicalRecord"></div>

@Scripts.Render("~/bundles/jquery")
<script src="~/Scripts/popper.min.js"></script>
@Scripts.Render("~/bundles/bootstrap")
<script src="~/Scripts/jquery.unobtrusive-ajax.js" type="text/javascript"></script>
<script src="~/Scripts/Pages/FormularioExpedienteMedico.js" type="text/javascript"></script>